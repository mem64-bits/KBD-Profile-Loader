+#pragma once
+
+#include "ui/IProfileCommands.h"
+#include "ui/ISystemIntegration.h"
+#include "ui/ITrayIcon.h"
+#include "ui/IWindowController.h"
+#include "ui/TrayIconBase.h"
+
+#include <atomic>
+#include <mutex>
+#include <string>
+#include <vector>
+
+namespace test {
+
+    // Records every IProfileCommands call as a short string, e.g. "activate:1", "cycle:next".
+    class FakeProfileCommands : public ui::IProfileCommands {
+    public:
+        void activateSlot(const std::uint8_t slot) override { record("activate:" + std::to_string(slot)); }
+        void cycleProfile(const bool forward) override { record(forward ? "cycle:next" : "cycle:prev"); }
+        void applyActuation(const std::uint8_t slot, const ui::ActuationSettings& settings, const bool save) override {
+            record("apply:" + std::to_string(slot) + ":" + std::to_string(settings.actuationTenths) + (save ? ":save" : ""));
+            lastApplied = settings;
+        }
+        void readActuation(const std::uint8_t slot) override { record("read:" + std::to_string(slot)); }
+        void flashSlot(const std::uint8_t slot) override { record("flash:" + std::to_string(slot)); }
+        void refresh() override { record("refresh"); }
+
+        [[nodiscard]] std::vector<std::string> calls() const {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            return m_calls;
+        }
+
+        ui::ActuationSettings lastApplied;
+
+    private:
+        void record(std::string call) {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            m_calls.push_back(std::move(call));
+        }
+
+        mutable std::mutex       m_mutex;
+        std::vector<std::string> m_calls;
+    };
+
+    class FakeSystemIntegration : public ui::ISystemIntegration {
+    public:
+        void openProfilesFolder() override { record("profiles"); }
+        void openConfigFile() override { record("config"); }
+        void openLogFile() override { record("log"); }
+        [[nodiscard]] bool isAutostartEnabled() const override { return autostart.load(); }
+        bool setAutostartEnabled(const bool enabled) override {
+            record(enabled ? "autostart:on" : "autostart:off");
+            autostart = enabled;
+            return true;
+        }
+
+        [[nodiscard]] std::vector<std::string> calls() const {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            return m_calls;
+        }
+
+        std::atomic<bool> autostart{false};
+
+    private:
+        void record(std::string call) {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            m_calls.push_back(std::move(call));
+        }
+
+        mutable std::mutex       m_mutex;
+        std::vector<std::string> m_calls;
+    };
+
+    class FakeWindowController : public ui::IWindowController {
+    public:
+        void showDashboard() override { ++shows; visible = true; }
+        void hideDashboard() override { ++hides; visible = false; }
+        void toggleDashboard() override { ++toggles; visible = !visible; }
+        [[nodiscard]] bool isDashboardVisible() const noexcept override { return visible; }
+
+        std::atomic<int>  shows{0};
+        std::atomic<int>  hides{0};
+        std::atomic<int>  toggles{0};
+        std::atomic<bool> visible{false};
+    };
+
+    // A TrayIconBase backend that draws nothing but counts what it was asked to draw and lets a test
+    // simulate the user clicking the icon or choosing a menu entry.
+    class FakeTrayIcon : public ui::TrayIconBase {
+    public:
+        bool start() override {
+            started = startResult;
+            return startResult;
+        }
+        void stop() override { started = false; }
+        [[nodiscard]] bool isRunning() const noexcept override { return started; }
+        [[nodiscard]] std::string_view backendName() const noexcept override { return "fake"; }
+
+        // --- simulate the user ---
+        void click() { notifyActivated(); }
+        void middleClick() { notifySecondaryActivated(); }
+        void choose(const int itemId) { notifyMenuItemSelected(itemId); }
+
+        // --- inspect what was shown ---
+        [[nodiscard]] ui::TrayMenu menu() const { return state().menu; }
+        [[nodiscard]] std::string title() const { return state().title; }
+        [[nodiscard]] std::string description() const { return state().description; }
+        [[nodiscard]] std::vector<ui::TrayImage> icons() const { return state().icons; }
+
+        bool              startResult = true;
+        std::atomic<bool> started{false};
+        std::atomic<int>  menuUpdates{0};
+        std::atomic<int>  iconUpdates{0};
+        std::atomic<int>  tooltipUpdates{0};
+
+    private:
+        void onStateChanged(const unsigned changes) override {
+            if (changes & MenuChanged) ++menuUpdates;
+            if (changes & IconChanged) ++iconUpdates;
+            if (changes & TooltipChanged) ++tooltipUpdates;
+        }
+    };
+
+} // namespace test
diff --git a/tests/support/TempDir.h b/tests/support/TempDir.h
new file mode 100644
index 0000000..1376e80
--- /dev/null
+++ b/tests/support/TempDir.h
@@ -0,0 +1,39 @@
+#pragma once
+
+#include <atomic>
+#include <chrono>
+#include <filesystem>
+#include <string>
+#include <system_error>
+
+namespace test {
+
+    // Creates a unique scratch directory and removes it (recursively) on destruction.
+    class TempDir {
+    public:
+        TempDir() {
+            static std::atomic<unsigned> counter{0};
+            const auto stamp = std::chrono::steady_clock::now().time_since_epoch().count();
+            m_path = std::filesystem::temp_directory_path() /
+                     ("kbd_tests_" + std::to_string(stamp) + "_" + std::to_string(counter++));
+            std::filesystem::create_directories(m_path);
+        }
+
+        ~TempDir() {
+            std::error_code ec;
+            std::filesystem::remove_all(m_path, ec);
+        }
+
+        TempDir(const TempDir&) = delete;
+        TempDir& operator=(const TempDir&) = delete;
+        TempDir(TempDir&&) = delete;
+        TempDir& operator=(TempDir&&) = delete;
+
+        [[nodiscard]] const std::filesystem::path& path() const noexcept { return m_path; }
+        [[nodiscard]] std::filesystem::path operator/(const std::string& name) const { return m_path / name; }
+
+    private:
+        std::filesystem::path m_path;
+    };
+
+} // namespace test
diff --git a/tests/test_actuation.cpp b/tests/test_actuation.cpp
new file mode 100644
index 0000000..446d6a1
--- /dev/null
+++ b/tests/test_actuation.cpp
@@ -0,0 +1,92 @@
+#include <gtest/gtest.h>
+
+#include "ui/ActuationModel.h"
+
+#include <cmath>
+
+using ui::ActuationSettings;
+namespace act = ui::actuation;
+
+TEST(ActuationModelTest, DefaultsMatchTheFirmwareDefaults) {
+    const ActuationSettings defaults;
+    EXPECT_FALSE(defaults.rapidTrigger);
+    EXPECT_EQ(defaults.actuationTenths, 20); // 2.0 mm
+    EXPECT_EQ(defaults.pressTenths, 4);      // 0.4 mm
+    EXPECT_EQ(defaults.releaseTenths, 4);
+}
+
+TEST(ActuationModelTest, MillimetreConversionIsExactInTenths) {
+    EXPECT_FLOAT_EQ(act::toMillimetres(3), 0.3f);
+    EXPECT_FLOAT_EQ(act::toMillimetres(39), 3.9f);
+
+    EXPECT_EQ(act::fromMillimetres(0.3f), 3);
+    EXPECT_EQ(act::fromMillimetres(1.4f), 14);
+    EXPECT_EQ(act::fromMillimetres(0.34f), 3);  // rounds to the nearest tenth
+    EXPECT_EQ(act::fromMillimetres(0.36f), 4);
+}
+
+TEST(ActuationModelTest, ConversionClampsToWhatTheFirmwareAccepts) {
+    EXPECT_EQ(act::fromMillimetres(-5.0f), act::MIN_TENTHS);
+    EXPECT_EQ(act::fromMillimetres(0.0f), act::MIN_TENTHS); // 0 would mean "use the default" on the keyboard
+    EXPECT_EQ(act::fromMillimetres(4.0f), act::MAX_TENTHS); // 4.0 mm is rejected (limit is 3.9)
+    EXPECT_EQ(act::fromMillimetres(100.0f), act::MAX_TENTHS);
+    EXPECT_EQ(act::fromMillimetres(std::nanf("")), act::DEFAULT_ACTUATION_TENTHS);
+
+    EXPECT_EQ(act::clampTenths(-1), 1);
+    EXPECT_EQ(act::clampTenths(0), 1);
+    EXPECT_EQ(act::clampTenths(40), 39);
+    EXPECT_EQ(act::clampTenths(255), 39);
+}
+
+TEST(ActuationModelTest, SanitizedClampsEveryDistanceAndKeepsTheMode) {
+    const ActuationSettings wild{true, 0, 200, 40};
+
+    const ActuationSettings clean = act::sanitized(wild);
+
+    EXPECT_TRUE(clean.rapidTrigger);
+    EXPECT_EQ(clean.actuationTenths, 1);
+    EXPECT_EQ(clean.pressTenths, 39);
+    EXPECT_EQ(clean.releaseTenths, 39);
+    EXPECT_EQ(act::sanitized(clean), clean) << "sanitizing must be idempotent";
+}
+
+TEST(ActuationModelTest, GlobalTravelDecodingFollowsTheFirmwareLoadRules) {
+    // Rapid Trigger profile from a Launcher dump.
+    const auto rapid = act::fromGlobalTravel({kbd::GlobalTravelConfig::MODE_RAPID, 3, 1, 2, 0, 0});
+    EXPECT_EQ(rapid, (ActuationSettings{true, 3, 1, 2}));
+
+    // Regular mode is *not* Rapid Trigger.
+    const auto regular = act::fromGlobalTravel({kbd::GlobalTravelConfig::MODE_REGULAR, 14, 4, 4, 0, 0});
+    EXPECT_FALSE(regular.rapidTrigger);
+    EXPECT_EQ(regular.actuationTenths, 14);
+
+    // 0 / out-of-range values fall back to defaults; a release sensitivity of 0 means "same as press".
+    const auto blank = act::fromGlobalTravel({kbd::GlobalTravelConfig::MODE_REGULAR, 0, 0, 0, 0, 0});
+    EXPECT_EQ(blank, ActuationSettings{});
+    const auto outOfRange = act::fromGlobalTravel({kbd::GlobalTravelConfig::MODE_RAPID, 63, 63, 0, 0, 0});
+    EXPECT_EQ(outOfRange.actuationTenths, ui::actuation::DEFAULT_ACTUATION_TENTHS);
+    EXPECT_EQ(outOfRange.pressTenths, ui::actuation::DEFAULT_SENSITIVITY_TENTHS);
+    EXPECT_EQ(outOfRange.releaseTenths, outOfRange.pressTenths);
+
+    // The firmware's own limit for loaded profiles is 40; the setter only accepts 39, so we clamp.
+    EXPECT_EQ(act::fromGlobalTravel({kbd::GlobalTravelConfig::MODE_REGULAR, 40, 4, 4, 0, 0}).actuationTenths, 39);
+}
+
+TEST(ActuationModelTest, FormattingIsHumanReadable) {
+    EXPECT_EQ(act::formatMillimetres(3), "0.3 mm");
+    EXPECT_EQ(act::formatMillimetres(20), "2.0 mm");
+    EXPECT_EQ(act::describe({false, 20, 4, 4}), "2.0 mm, Rapid Trigger off");
+    EXPECT_EQ(act::describe({true, 3, 1, 2}), "0.3 mm, Rapid Trigger 0.1 mm / 0.2 mm");
+}
+
+TEST(ActuationModelTest, PresetsAreValidForTheFirmware) {
+    const auto presets = act::presets();
+    ASSERT_FALSE(presets.empty());
+
+    for (const auto& preset : presets) {
+        EXPECT_FALSE(preset.name.empty());
+        EXPECT_EQ(act::sanitized(preset.settings), preset.settings) << preset.name << " has out-of-range values";
+    }
+    // The first preset restores the firmware defaults.
+    EXPECT_EQ(presets.front().settings, ActuationSettings{});
+}
diff --git a/tests/test_app_model.cpp b/tests/test_app_model.cpp
new file mode 100644
index 0000000..2f7bad2
--- /dev/null
+++ b/tests/test_app_model.cpp
@@ -0,0 +1,133 @@
+#include <gtest/gtest.h>
+
+#include "ui/AppModel.h"
+
+#include <thread>
+#include <vector>
+
+namespace {
+
+    class CountingObserver : public ui::IAppModelObserver {
+    public:
+        void onAppStateChanged(const ui::AppSnapshot& snapshot) override {
+            ++calls;
+            last = snapshot;
+        }
+
+        int             calls = 0;
+        ui::AppSnapshot last;
+    };
+
+}
+
+TEST(AppModelTest, StartsWithUnknownDisconnectedState) {
+    ui::AppModel model;
+    const auto state = model.snapshot();
+
+    EXPECT_FALSE(state.device.connected);
+    EXPECT_EQ(state.activeSlot, -1);
+    EXPECT_FALSE(state.busy);
+    EXPECT_EQ(state.status.severity, ui::StatusSeverity::None);
+    for (const auto& slot : state.slots) EXPECT_FALSE(slot.hasProfile);
+}
+
+TEST(AppModelTest, UpdateChangesTheSnapshotAndNotifiesObservers) {
+    ui::AppModel model;
+    CountingObserver observer;
+    model.addObserver(&observer);
+    const auto before = model.revision();
+
+    model.update([](ui::AppSnapshot& state) { state.activeSlot = 2; });
+
+    EXPECT_EQ(model.snapshot().activeSlot, 2);
+    EXPECT_EQ(observer.calls, 1);
+    EXPECT_EQ(observer.last.activeSlot, 2);
+    EXPECT_EQ(model.revision(), before + 1);
+    model.removeObserver(&observer);
+}
+
+TEST(AppModelTest, NoOpUpdatesAreSilent) {
+    ui::AppModel model;
+    model.update([](ui::AppSnapshot& state) { state.activeSlot = 1; });
+    CountingObserver observer;
+    model.addObserver(&observer);
+    const auto before = model.revision();
+
+    model.update([](ui::AppSnapshot& state) { state.activeSlot = 1; }); // same value
+    model.update([](ui::AppSnapshot&) {});                              // does nothing
+
+    EXPECT_EQ(observer.calls, 0);
+    EXPECT_EQ(model.revision(), before);
+    model.removeObserver(&observer);
+}
+
+TEST(AppModelTest, RepeatedStatusTextStillCountsAsAChange) {
+    ui::AppModel model;
+    CountingObserver observer;
+    model.addObserver(&observer);
+
+    model.setStatus(ui::StatusSeverity::Info, "Working");
+    const auto first = model.snapshot().status.serial;
+    model.setStatus(ui::StatusSeverity::Info, "Working");
+
+    EXPECT_EQ(observer.calls, 2);
+    EXPECT_GT(model.snapshot().status.serial, first);
+    EXPECT_EQ(model.snapshot().status.text, "Working");
+    model.removeObserver(&observer);
+}
+
+TEST(AppModelTest, RemovedObserverIsNotNotified) {
+    ui::AppModel model;
+    CountingObserver observer;
+    model.addObserver(&observer);
+    model.removeObserver(&observer);
+
+    model.update([](ui::AppSnapshot& state) { state.busy = true; });
+
+    EXPECT_EQ(observer.calls, 0);
+}
+
+TEST(AppModelTest, ObserverMayReadTheModelFromItsCallback) {
+    struct Reader : ui::IAppModelObserver {
+        explicit Reader(ui::AppModel& m) : model(m) {}
+        void onAppStateChanged(const ui::AppSnapshot&) override { seen = model.snapshot().activeSlot; }
+        ui::AppModel& model;
+        int seen = -99;
+    };
+    ui::AppModel model;
+    Reader reader(model);
+    model.addObserver(&reader);
+
+    model.update([](ui::AppSnapshot& state) { state.activeSlot = 1; });
+
+    EXPECT_EQ(reader.seen, 1);
+    model.removeObserver(&reader);
+}
+
+TEST(AppModelTest, ConcurrentWritersNeverLoseAnUpdate) {
+    ui::AppModel model;
+    constexpr int THREADS = 4;
+    constexpr int UPDATES = 500;
+
+    std::vector<std::thread> workers;
+    for (int t = 0; t < THREADS; ++t) {
+        workers.emplace_back([&model] {
+            for (int i = 0; i < UPDATES; ++i) {
+                model.update([](ui::AppSnapshot& state) { ++state.activeSlot; });
+                (void)model.snapshot();
+            }
+        });
+    }
+    for (auto& worker : workers) worker.join();
+
+    EXPECT_EQ(model.snapshot().activeSlot, -1 + THREADS * UPDATES);
+    EXPECT_EQ(model.revision(), static_cast<std::uint64_t>(THREADS * UPDATES));
+}
+
+TEST(AppStateTest, LabelsAreOneBased) {
+    EXPECT_EQ(ui::slotLabel(0), "Slot 1");
+    EXPECT_EQ(ui::slotLabel(2), "Slot 3");
+    EXPECT_STREQ(ui::transportName(kbd::TransportMode::Wired), "Wired USB-C");
+    EXPECT_STREQ(ui::transportName(kbd::TransportMode::WirelessDongle), "2.4G dongle");
+    EXPECT_STREQ(ui::transportName(kbd::TransportMode::Disconnected), "Disconnected");
+}
diff --git a/tests/test_png_and_demo.cpp b/tests/test_png_and_demo.cpp
new file mode 100644
index 0000000..ff62959
--- /dev/null
+++ b/tests/test_png_and_demo.cpp
@@ -0,0 +1,221 @@
+#include <gtest/gtest.h>
+
+#include "support/TempDir.h"
+#include "ui/AppModel.h"
+#include "ui/DemoProfileGateway.h"
+#include "ui/PngWriter.h"
+#include "ui/ProfileController.h"
+
+#include <chrono>
+#include <fstream>
+#include <thread>
+
+using namespace std::chrono_literals;
+
+// ---------------------------------------------------------------------------
+// PNG writer: decode our own output (CRCs, zlib stored blocks, Adler-32) and compare the pixels
+// ---------------------------------------------------------------------------
+
+namespace {
+
+    std::uint32_t readU32(const std::vector<std::uint8_t>& b, const std::size_t at) {
+        return (static_cast<std::uint32_t>(b[at]) << 24) | (static_cast<std::uint32_t>(b[at + 1]) << 16) |
+               (static_cast<std::uint32_t>(b[at + 2]) << 8) | b[at + 3];
+    }
+
+    std::uint32_t crc32(const std::uint8_t* data, const std::size_t size) {
+        std::uint32_t crc = 0xFFFFFFFFu;
+        for (std::size_t i = 0; i < size; ++i) {
+            crc ^= data[i];
+            for (int k = 0; k < 8; ++k) crc = (crc & 1u) ? 0xEDB88320u ^ (crc >> 1) : crc >> 1;
+        }
+        return crc ^ 0xFFFFFFFFu;
+    }
+
+    struct Decoded {
+        int                       width = 0, height = 0;
+        std::vector<std::uint8_t> rgb;
+        bool                      valid = false;
+    };
+
+    Decoded decodeStoredPng(const std::vector<std::uint8_t>& png) {
+        Decoded out;
+        const std::vector<std::uint8_t> signature{0x89, 'P', 'N', 'G', '\r', '\n', 0x1A, '\n'};
+        if (png.size() < 8 || !std::equal(signature.begin(), signature.end(), png.begin())) return out;
+
+        std::vector<std::uint8_t> zlib;
+        std::size_t pos = 8;
+        bool sawEnd = false;
+        while (pos + 12 <= png.size()) {
+            const std::uint32_t length = readU32(png, pos);
+            const std::string type(reinterpret_cast<const char*>(&png[pos + 4]), 4);
+            if (pos + 12 + length > png.size()) return out;
+            if (readU32(png, pos + 8 + length) != crc32(&png[pos + 4], 4 + length)) return out; // bad CRC
+
+            if (type == "IHDR") {
+                out.width  = static_cast<int>(readU32(png, pos + 8));
+                out.height = static_cast<int>(readU32(png, pos + 12));
+                if (png[pos + 16] != 8 || png[pos + 17] != 2) return out; // 8-bit RGB expected
+            } else if (type == "IDAT") {
+                zlib.insert(zlib.end(), png.begin() + static_cast<std::ptrdiff_t>(pos + 8),
+                            png.begin() + static_cast<std::ptrdiff_t>(pos + 8 + length));
+            } else if (type == "IEND") {
+                sawEnd = true;
+            }
+            pos += 12 + length;
+        }
+        if (!sawEnd || zlib.size() < 6) return out;
+
+        std::vector<std::uint8_t> raw;
+        std::size_t z = 2; // skip the zlib header
+        for (bool last = false; !last;) {
+            last = (zlib[z] & 1) != 0;
+            if ((zlib[z] >> 1) != 0) return out; // only stored blocks are produced
+            const std::size_t len = zlib[z + 1] | (zlib[z + 2] << 8);
+            const std::size_t nlen = zlib[z + 3] | (zlib[z + 4] << 8);
+            if ((len ^ 0xFFFFu) != nlen) return out;
+            raw.insert(raw.end(), zlib.begin() + static_cast<std::ptrdiff_t>(z + 5), zlib.begin() + static_cast<std::ptrdiff_t>(z + 5 + len));
+            z += 5 + len;
+        }
+
+        std::uint32_t a = 1, b = 0;
+        for (const auto byte : raw) { a = (a + byte) % 65521u; b = (b + a) % 65521u; }
+        if (readU32(zlib, z) != ((b << 16) | a)) return out; // Adler-32 mismatch
+
+        const std::size_t rowBytes = static_cast<std::size_t>(out.width) * 3;
+        for (int y = 0; y < out.height; ++y) {
+            const std::size_t row = static_cast<std::size_t>(y) * (rowBytes + 1);
+            if (raw[row] != 0) return out; // filter type none
+            out.rgb.insert(out.rgb.end(), raw.begin() + static_cast<std::ptrdiff_t>(row + 1), raw.begin() + static_cast<std::ptrdiff_t>(row + 1 + rowBytes));
+        }
+        out.valid = true;
+        return out;
+    }
+
+    std::vector<std::uint8_t> gradient(const int width, const int height) {
+        std::vector<std::uint8_t> rgb;
+        for (int y = 0; y < height; ++y) {
+            for (int x = 0; x < width; ++x) {
+                rgb.push_back(static_cast<std::uint8_t>(x * 7));
+                rgb.push_back(static_cast<std::uint8_t>(y * 11));
+                rgb.push_back(static_cast<std::uint8_t>(x ^ y));
+            }
+        }
+        return rgb;
+    }
+
+}
+
+TEST(PngWriterTest, SmallImageRoundTrips) {
+    const auto pixels = gradient(7, 5);
+
+    const auto decoded = decodeStoredPng(ui::encodePng(7, 5, pixels));
+
+    ASSERT_TRUE(decoded.valid);
+    EXPECT_EQ(decoded.width, 7);
+    EXPECT_EQ(decoded.height, 5);
+    EXPECT_EQ(decoded.rgb, pixels);
+}
+
+TEST(PngWriterTest, ImagesLargerThanOneStoredBlockRoundTrip) {
+    const auto pixels = gradient(200, 150); // 90 150 raw bytes > 65 535: needs two deflate blocks
+
+    const auto decoded = decodeStoredPng(ui::encodePng(200, 150, pixels));
+
+    ASSERT_TRUE(decoded.valid);
+    EXPECT_EQ(decoded.rgb, pixels);
+}
+
+TEST(PngWriterTest, RejectsInconsistentInput) {
+    EXPECT_TRUE(ui::encodePng(4, 4, gradient(4, 3)).empty()) << "buffer too small for 4x4";
+    EXPECT_TRUE(ui::encodePng(0, 4, {}).empty());
+    EXPECT_TRUE(ui::encodePng(4, -1, {}).empty());
+}
+
+TEST(PngWriterTest, WritesAFileToDisk) {
+    test::TempDir dir;
+    const auto path = dir / "shot.png";
+
+    ASSERT_TRUE(ui::writePng(path, 3, 2, gradient(3, 2)));
+
+    std::ifstream file(path, std::ios::binary);
+    std::vector<std::uint8_t> bytes((std::istreambuf_iterator<char>(file)), std::istreambuf_iterator<char>());
+    EXPECT_TRUE(decodeStoredPng(bytes).valid);
+    EXPECT_FALSE(ui::writePng(dir / "missing-dir/shot.png", 3, 2, gradient(3, 2)));
+}
+
+// ---------------------------------------------------------------------------
+// Demo gateway (simulated keyboard), alone and driven by the real controller
+// ---------------------------------------------------------------------------
+
+TEST(DemoGatewayTest, DescribesAConnectedKeyboardWithThreeProfiles) {
+    ui::DemoProfileGateway gateway(0ms);
+
+    EXPECT_TRUE(gateway.describeDevice().connected);
+    for (const auto& slot : gateway.describeSlots()) {
+        EXPECT_TRUE(slot.hasProfile);
+        EXPECT_FALSE(slot.name.empty());
+        EXPECT_TRUE(slot.storedSettings.has_value());
+    }
+    EXPECT_EQ(gateway.queryActiveSlot(), 0);
+}
+
+TEST(DemoGatewayTest, CyclingWrapsInBothDirections) {
+    ui::DemoProfileGateway gateway(0ms);
+
+    gateway.cycleProfile(false);
+    EXPECT_EQ(gateway.queryActiveSlot(), 2);
+    gateway.cycleProfile(true);
+    gateway.cycleProfile(true);
+    EXPECT_EQ(gateway.queryActiveSlot(), 1);
+}
+
+TEST(DemoGatewayTest, AppliedSettingsCanBeReadBackAndFlashRestoresTheProfile) {
+    ui::DemoProfileGateway gateway(0ms);
+
+    ASSERT_TRUE(gateway.applyActuation(1, ui::ActuationSettings{false, 17, 2, 2}).ok);
+    EXPECT_EQ(gateway.readActuation(1, std::nullopt), (ui::ActuationSettings{false, 17, 2, 2}));
+
+    ASSERT_TRUE(gateway.flashSlotProfile(1).ok);
+    EXPECT_EQ(gateway.readActuation(1, std::nullopt), (ui::ActuationSettings{true, 3, 1, 1})) << "back to the profile file's values";
+}
+
+TEST(DemoGatewayTest, TheRealControllerDrivesItEndToEnd) {
+    ui::DemoProfileGateway gateway(0ms);
+    ui::AppModel model;
+    ui::ProfileController controller(gateway, model, 20ms);
+    controller.start();
+
+    const auto waitFor = [&](auto&& predicate) {
+        const auto deadline = std::chrono::steady_clock::now() + 3s;
+        while (!predicate() && std::chrono::steady_clock::now() < deadline) std::this_thread::sleep_for(1ms);
+        return predicate();
+    };
+    const auto idleWith = [&](const ui::StatusSeverity severity) {
+        return [&model, severity] {
+            const auto s = model.snapshot();
+            return !s.busy && s.status.severity == severity;
+        };
+    };
+
+    ASSERT_TRUE(waitFor([&] { return model.snapshot().slots[1].name == "Tekken 8 Mishima"; }));
+    EXPECT_EQ(model.snapshot().activeSlot, 0);
+
+    controller.activateSlot(2);
+    ASSERT_TRUE(waitFor(idleWith(ui::StatusSeverity::Success)));
+    EXPECT_EQ(model.snapshot().activeSlot, 2);
+
+    controller.applyActuation(1, ui::ActuationSettings{true, 5, 2, 2}, true);
+    ASSERT_TRUE(waitFor([&] {
+        const auto s = model.snapshot();
+        return !s.busy && s.status.text.find("Saved") != std::string::npos;
+    }));
+    EXPECT_EQ(model.snapshot().status.severity, ui::StatusSeverity::Success);
+    EXPECT_NE(model.snapshot().status.text.find("verified"), std::string::npos);
+    EXPECT_EQ(model.snapshot().actuation[1], (ui::ActuationSettings{true, 5, 2, 2}));
+
+    controller.cycleProfile(true);
+    ASSERT_TRUE(waitFor([&] { return !model.snapshot().busy && model.snapshot().activeSlot == 0; }));
+
+    controller.stop();
+}
diff --git a/tests/test_profile_controller.cpp b/tests/test_profile_controller.cpp
new file mode 100644
index 0000000..173702c
--- /dev/null
+++ b/tests/test_profile_controller.cpp
@@ -0,0 +1,417 @@
+#include <gtest/gtest.h>
+
+#include "support/FakeProfileGateway.h"
+#include "ui/AppModel.h"
+#include "ui/ProfileController.h"
+
+#include <algorithm>
+#include <chrono>
+#include <future>
+#include <thread>
+
+using namespace std::chrono_literals;
+using ui::ActuationSettings;
+using ui::StatusSeverity;
+
+namespace {
+
+    template <typename Predicate>
+    bool waitUntil(Predicate&& predicate, const std::chrono::milliseconds timeout = 3000ms) {
+        const auto deadline = std::chrono::steady_clock::now() + timeout;
+        while (std::chrono::steady_clock::now() < deadline) {
+            if (predicate()) return true;
+            std::this_thread::sleep_for(1ms);
+        }
+        return predicate();
+    }
+
+    bool contains(const std::string& text, const std::string& part) {
+        return text.find(part) != std::string::npos;
+    }
+
+    class ProfileControllerTest : public ::testing::Test {
+    protected:
+        void SetUp() override {
+            gateway.slots[0] = {true, "Default", "default.json", ActuationSettings{}};
+            gateway.slots[1] = {true, "Tekken 8", "tekken.json", ActuationSettings{true, 3, 1, 1}};
+            gateway.slots[2] = {false, "Slot 3", "", std::nullopt};
+            gateway.hardware = ActuationSettings{};
+            gateway.activeSlot = 0;
+        }
+
+        void TearDown() override { controller.stop(); }
+
+        // Waits for a command to finish: not busy any more and the last status has the given severity.
+        bool waitForStatus(const StatusSeverity severity) {
+            return waitUntil([&] {
+                const auto state = model.snapshot();
+                return !state.busy && state.status.severity == severity;
+            });
+        }
+
+        test::FakeProfileGateway gateway;
+        ui::AppModel             model;
+        ui::ProfileController    controller{gateway, model, 20ms};
+    };
+
+} // namespace
+
+// ---------------------------------------------------------------------------
+// Start-up and state publication
+// ---------------------------------------------------------------------------
+
+TEST_F(ProfileControllerTest, StartPublishesTheInitialStateFromTheGateway) {
+    controller.start();
+
+    ASSERT_TRUE(waitUntil([&] { return model.snapshot().slots[1].name == "Tekken 8"; }));
+    const auto state = model.snapshot();
+    EXPECT_TRUE(state.device.connected);
+    EXPECT_EQ(state.device.transport, kbd::TransportMode::Wired);
+    EXPECT_EQ(state.activeSlot, 0);
+    EXPECT_TRUE(state.slots[0].hasProfile);
+    EXPECT_FALSE(state.slots[2].hasProfile);
+    EXPECT_FALSE(state.busy);
+}
+
+TEST_F(ProfileControllerTest, CommandsQueuedBeforeStartRunAfterwards) {
+    controller.activateSlot(1);
+    EXPECT_EQ(gateway.countOf("activate"), 0);
+
+    controller.start();
+
+    ASSERT_TRUE(waitForStatus(StatusSeverity::Success));
+    EXPECT_EQ(model.snapshot().activeSlot, 1);
+}
+
+TEST_F(ProfileControllerTest, CommandsAfterStopAreIgnoredAndStopIsIdempotent) {
+    controller.start();
+    controller.stop();
+    EXPECT_NO_THROW(controller.stop());
+
+    controller.activateSlot(1);
+    std::this_thread::sleep_for(60ms);
+
+    EXPECT_EQ(gateway.countOf("activate"), 0);
+}
+
+// ---------------------------------------------------------------------------
+// Slot switching
+// ---------------------------------------------------------------------------
+
+TEST_F(ProfileControllerTest, ActivateSlotSwitchesAndReportsSuccess) {
+    controller.start();
+
+    controller.activateSlot(1);
+
+    ASSERT_TRUE(waitForStatus(StatusSeverity::Success));
+    const auto state = model.snapshot();
+    EXPECT_EQ(state.activeSlot, 1);
+    EXPECT_EQ(state.status.text, "Slot active");
+    EXPECT_EQ(gateway.countOf("activate:1"), 1);
+}
+
+TEST_F(ProfileControllerTest, SlotIndexWrapsLikeTheFirmware) {
+    controller.start();
+
+    controller.activateSlot(7); // 7 % 3 == 1
+
+    ASSERT_TRUE(waitForStatus(StatusSeverity::Success));
+    EXPECT_EQ(gateway.countOf("activate:1"), 1);
+}
+
+TEST_F(ProfileControllerTest, FailedActivationIsReportedAndKeepsTheOldSlot) {
+    gateway.activateResult = {false, "Keyboard did not confirm the switch"};
+    controller.start();
+    ASSERT_TRUE(waitUntil([&] { return model.snapshot().activeSlot == 0; }));
+
+    controller.activateSlot(2);
+
+    ASSERT_TRUE(waitForStatus(StatusSeverity::Error));
+    EXPECT_EQ(model.snapshot().status.text, "Keyboard did not confirm the switch");
+    EXPECT_EQ(model.snapshot().activeSlot, 0);
+}
+
+TEST_F(ProfileControllerTest, ExceptionFromTheGatewayBecomesAnErrorAndTheWorkerSurvives) {
+    gateway.throwOnActivate = true;
+    controller.start();
+
+    controller.activateSlot(1);
+    ASSERT_TRUE(waitForStatus(StatusSeverity::Error));
+    EXPECT_TRUE(contains(model.snapshot().status.text, "boom"));
+
+    gateway.throwOnActivate = false;
+    controller.activateSlot(2);
+    ASSERT_TRUE(waitForStatus(StatusSeverity::Success));
+    EXPECT_EQ(model.snapshot().activeSlot, 2);
+}
+
+TEST_F(ProfileControllerTest, BusyFlagIsRaisedWhileTheKeyboardIsWorking) {
+    std::promise<void> release;
+    const auto gate = release.get_future().share();
+    gateway.onActivate = [gate] { gate.wait(); };
+    controller.start();
+
+    controller.activateSlot(1);
+
+    ASSERT_TRUE(waitUntil([&] { return model.snapshot().busy; }));
+    EXPECT_EQ(model.snapshot().status.severity, StatusSeverity::Info);
+    EXPECT_TRUE(contains(model.snapshot().status.text, "Switching to Slot 2"));
+
+    release.set_value();
+    ASSERT_TRUE(waitForStatus(StatusSeverity::Success));
+    EXPECT_FALSE(model.snapshot().busy);
+}
+
+TEST_F(ProfileControllerTest, CommandsRunInOrderOnASingleWorkerThread) {
+    controller.start();
+
+    controller.activateSlot(1);
+    controller.cycleProfile(true);
+    controller.activateSlot(2);
+    controller.cycleProfile(false);
+
+    ASSERT_TRUE(waitUntil([&] { return gateway.countOf("cycle:prev") == 1 && !model.snapshot().busy; }));
+
+    std::vector<std::string> commands;
+    for (const auto& call : gateway.calls()) {
+        if (call.rfind("activate", 0) == 0 || call.rfind("cycle", 0) == 0) commands.push_back(call);
+    }
+    EXPECT_EQ(commands, (std::vector<std::string>{"activate:1", "cycle:next", "activate:2", "cycle:prev"}));
+
+    const auto threads = gateway.threadIds();
+    ASSERT_FALSE(threads.empty());
+    EXPECT_TRUE(std::all_of(threads.begin(), threads.end(), [&](const auto id) { return id == threads.front(); }));
+    EXPECT_NE(threads.front(), std::this_thread::get_id()) << "hardware work must not run on the caller's thread";
+}
+
+TEST_F(ProfileControllerTest, GatewayFailuresDuringStateRefreshNeverLeaveTheModelBusy) {
+    gateway.throwOnDescribeSlots = true;
+    controller.start();
+
+    controller.flashSlot(1); // flashSlotProfile succeeds, then describeSlots() throws
+
+    ASSERT_TRUE(waitForStatus(StatusSeverity::Error));
+    EXPECT_TRUE(contains(model.snapshot().status.text, "describeSlots failed"));
+    EXPECT_FALSE(model.snapshot().busy);
+}
+
+// ---------------------------------------------------------------------------
+// Actuation
+// ---------------------------------------------------------------------------
+
+TEST_F(ProfileControllerTest, ApplyActuationIsVerifiedByReadingTheKeyboardBack) {
+    controller.start();
+    const ActuationSettings wanted{true, 3, 1, 1};
+
+    controller.applyActuation(1, wanted, false);
+
+    ASSERT_TRUE(waitForStatus(StatusSeverity::Success));
+    const auto state = model.snapshot();
+    EXPECT_TRUE(contains(state.status.text, "verified"));
+    EXPECT_EQ(state.actuation[1], wanted);
+    EXPECT_EQ(gateway.countOf("apply:1:3:rt:1:1"), 1);
+    EXPECT_EQ(gateway.countOf("read:1"), 1);
+    EXPECT_EQ(gateway.countOf("save"), 0);
+}
+
+TEST_F(ProfileControllerTest, ApplyActuationWarnsWhenTheKeyboardReportsSomethingElse) {
+    gateway.firmwareOverride = ActuationSettings{false, 3, 1, 1}; // keyboard ends up in regular mode
+    controller.start();
+
+    controller.applyActuation(1, ActuationSettings{true, 3, 1, 1}, false);
+
+    ASSERT_TRUE(waitForStatus(StatusSeverity::Warning));
+    const auto state = model.snapshot();
+    EXPECT_TRUE(contains(state.status.text, "instead of"));
+    EXPECT_TRUE(contains(state.status.text, "Rapid Trigger mode byte"));
+    EXPECT_EQ(state.actuation[1], *gateway.firmwareOverride) << "the model must show what the keyboard really holds";
+}
+
+TEST_F(ProfileControllerTest, ApplyActuationClampsValuesBeforeTheyReachTheKeyboard) {
+    controller.start();
+
+    controller.applyActuation(1, ActuationSettings{false, 0, 99, 99}, false);
+
+    ASSERT_TRUE(waitForStatus(StatusSeverity::Success));
+    EXPECT_EQ(gateway.countOf("apply:1:1:static:39:39"), 1);
+}
+
+TEST_F(ProfileControllerTest, ApplyActuationCanSaveToFlash) {
+    controller.start();
+
+    controller.applyActuation(2, ActuationSettings{false, 14, 4, 4}, true);
+
+    ASSERT_TRUE(waitForStatus(StatusSeverity::Success));
+    EXPECT_EQ(gateway.countOf("save:2"), 1);
+    EXPECT_TRUE(contains(model.snapshot().status.text, "Saved to the keyboard's flash"));
+}
+
+TEST_F(ProfileControllerTest, FailedSaveDowngradesTheOutcomeToAWarning) {
+    gateway.saveResult = {false, "Keyboard rejected the save"};
+    controller.start();
+
+    controller.applyActuation(2, ActuationSettings{false, 14, 4, 4}, true);
+
+    ASSERT_TRUE(waitForStatus(StatusSeverity::Warning));
+    EXPECT_TRUE(contains(model.snapshot().status.text, "Saving to flash failed: Keyboard rejected the save"));
+}
+
+TEST_F(ProfileControllerTest, RejectedActuationSkipsVerificationAndSaving) {
+    gateway.applyResult = {false, "Keyboard rejected the actuation settings"};
+    controller.start();
+
+    controller.applyActuation(1, ActuationSettings{true, 3, 1, 1}, true);
+
+    ASSERT_TRUE(waitForStatus(StatusSeverity::Error));
+    EXPECT_EQ(model.snapshot().status.text, "Keyboard rejected the actuation settings");
+    EXPECT_EQ(gateway.countOf("read"), 0);
+    EXPECT_EQ(gateway.countOf("save"), 0);
+}
+
+TEST_F(ProfileControllerTest, ApplyActuationWithoutReadBackIsReportedAsUnverified) {
+    gateway.readSupported = false;
+    controller.start();
+
+    controller.applyActuation(1, ActuationSettings{true, 3, 1, 1}, false);
+
+    ASSERT_TRUE(waitForStatus(StatusSeverity::Info));
+    EXPECT_TRUE(contains(model.snapshot().status.text, "could not read back"));
+    EXPECT_EQ(model.snapshot().actuation[1], (ActuationSettings{true, 3, 1, 1}));
+}
+
+TEST_F(ProfileControllerTest, ReadActuationPublishesWhatTheKeyboardHolds) {
+    gateway.hardware = ActuationSettings{true, 5, 2, 3};
+    controller.start();
+
+    controller.readActuation(0);
+
+    ASSERT_TRUE(waitForStatus(StatusSeverity::Info));
+    EXPECT_EQ(model.snapshot().actuation[0], (ActuationSettings{true, 5, 2, 3}));
+    EXPECT_TRUE(contains(model.snapshot().status.text, "0.5 mm"));
+}
+
+TEST_F(ProfileControllerTest, ReadActuationFailureIsAWarning) {
+    gateway.readSupported = false;
+    controller.start();
+
+    controller.readActuation(0);
+
+    ASSERT_TRUE(waitForStatus(StatusSeverity::Warning));
+    EXPECT_FALSE(model.snapshot().actuation[0].has_value());
+}
+
+// ---------------------------------------------------------------------------
+// Flashing a profile
+// ---------------------------------------------------------------------------
+
+TEST_F(ProfileControllerTest, FlashVerifiesAgainstTheProfileFile) {
+    gateway.hardware = gateway.slots[1].storedSettings; // keyboard ends up with the file's values
+    controller.start();
+
+    controller.flashSlot(1);
+
+    ASSERT_TRUE(waitForStatus(StatusSeverity::Success));
+    EXPECT_EQ(gateway.countOf("flash:1"), 1);
+    EXPECT_TRUE(contains(model.snapshot().status.text, "Verified"));
+}
+
+TEST_F(ProfileControllerTest, FlashWarnsWhenTheKeyboardStillHoldsOtherValues) {
+    gateway.hardware = ActuationSettings{}; // the write did not take effect
+    controller.start();
+
+    controller.flashSlot(1);
+
+    ASSERT_TRUE(waitForStatus(StatusSeverity::Warning));
+    const auto text = model.snapshot().status.text;
+    EXPECT_TRUE(contains(text, "while the profile file says"));
+    EXPECT_TRUE(contains(text, "may not accept raw profile writes"));
+}
+
+TEST_F(ProfileControllerTest, FlashFailureIsAnError) {
+    gateway.flashResult = {false, "No profile file is assigned to Slot 3"};
+    controller.start();
+
+    controller.flashSlot(2);
+
+    ASSERT_TRUE(waitForStatus(StatusSeverity::Error));
+    EXPECT_EQ(model.snapshot().status.text, "No profile file is assigned to Slot 3");
+    EXPECT_EQ(gateway.countOf("read"), 0);
+}
+
+// ---------------------------------------------------------------------------
+// Watcher events (the controller is an Files::IFileObserver / kbd::IDeviceObserver)
+// ---------------------------------------------------------------------------
+
+TEST_F(ProfileControllerTest, FileEventsAreForwardedAndRefreshTheSlots) {
+    controller.start();
+    ASSERT_TRUE(waitUntil([&] { return model.snapshot().slots[0].hasProfile; }));
+    gateway.slots[2] = {true, "Gamepad", "gamepad.json", std::nullopt};
+
+    controller.onFileCreated("/profiles/gamepad.json");
+
+    ASSERT_TRUE(waitUntil([&] { return model.snapshot().slots[2].hasProfile; }));
+    EXPECT_EQ(gateway.countOf("fileCreated:gamepad.json"), 1);
+    EXPECT_EQ(model.snapshot().status.text, "Profile file added: gamepad.json");
+
+    gateway.slots[2] = {false, "Slot 3", "", std::nullopt};
+    controller.onFileDeleted("/profiles/gamepad.json");
+
+    ASSERT_TRUE(waitUntil([&] { return !model.snapshot().slots[2].hasProfile; }));
+    EXPECT_EQ(gateway.countOf("fileDeleted:gamepad.json"), 1);
+}
+
+TEST_F(ProfileControllerTest, DeviceConnectedUpdatesTransportAndReappliesViaTheGateway) {
+    gateway.setDevice({false, kbd::TransportMode::Disconnected, ""});
+    controller.start();
+    ASSERT_TRUE(waitUntil([&] { return model.snapshot().status.serial == 0 && !model.snapshot().device.connected; }));
+
+    gateway.setDevice({true, kbd::TransportMode::WirelessDongle, "dongle-path"});
+    controller.onDeviceConnected(kbd::TransportMode::WirelessDongle, "dongle-path");
+
+    ASSERT_TRUE(waitForStatus(StatusSeverity::Success));
+    const auto state = model.snapshot();
+    EXPECT_TRUE(state.device.connected);
+    EXPECT_EQ(state.device.transport, kbd::TransportMode::WirelessDongle);
+    EXPECT_EQ(state.device.path, "dongle-path");
+    EXPECT_EQ(gateway.countOf("deviceConnected:2.4G dongle:dongle-path"), 1);
+    EXPECT_TRUE(contains(state.status.text, "2.4G dongle"));
+}
+
+TEST_F(ProfileControllerTest, DeviceDisconnectedClearsDeviceAndActiveSlot) {
+    controller.start();
+    ASSERT_TRUE(waitUntil([&] { return model.snapshot().activeSlot == 0; }));
+
+    gateway.setDevice({false, kbd::TransportMode::Disconnected, ""});
+    controller.onDeviceDisconnected();
+
+    ASSERT_TRUE(waitForStatus(StatusSeverity::Warning));
+    const auto state = model.snapshot();
+    EXPECT_FALSE(state.device.connected);
+    EXPECT_EQ(state.activeSlot, -1);
+    EXPECT_EQ(gateway.countOf("deviceDisconnected"), 1);
+}
+
+// ---------------------------------------------------------------------------
+// Polling
+// ---------------------------------------------------------------------------
+
+TEST_F(ProfileControllerTest, PollingPicksUpSlotChangesMadeOnTheKeyboardItself) {
+    controller.start();
+    ASSERT_TRUE(waitUntil([&] { return model.snapshot().activeSlot == 0; }));
+
+    controller.setPollingEnabled(true);
+    gateway.setActiveSlot(2); // e.g. the user pressed Fn+P+3 on the keyboard
+
+    EXPECT_TRUE(waitUntil([&] { return model.snapshot().activeSlot == 2; }));
+}
+
+TEST_F(ProfileControllerTest, NoPollingTrafficWhileDisabled) {
+    controller.start();
+    ASSERT_TRUE(waitUntil([&] { return model.snapshot().activeSlot == 0; }));
+    std::this_thread::sleep_for(80ms); // let any in-flight work settle
+    const int queriesBefore = gateway.countOf("query");
+
+    std::this_thread::sleep_for(200ms); // ten poll intervals
+
+    EXPECT_EQ(gateway.countOf("query"), queriesBefore);
+}
diff --git a/tests/test_profile_memory.cpp b/tests/test_profile_memory.cpp
new file mode 100644
index 0000000..3546e2d
--- /dev/null
+++ b/tests/test_profile_memory.cpp
@@ -0,0 +1,104 @@
+#include <gtest/gtest.h>
+
+#include "kbd/ProfileMemory.h"
+
+#include <array>
+#include <random>
+#include <vector>
+
+// Golden values: produced by compiling Keychron's own `analog_key_config_t` (packed bitfields, from
+// qmk_firmware keyboards/keychron/common/analog_matrix/analog_matrix_type.h) with GCC and dumping its
+// four bytes. Reading them back with our decoder proves the bit layout documented in ProfileMemory.h.
+namespace {
+
+    struct Golden {
+        kbd::GlobalTravelConfig config;
+        std::array<std::uint8_t, 4> bytes;
+    };
+
+    const std::vector<Golden>& goldenVectors() {
+        static const std::vector<Golden> vectors{
+            // mode, act, press, release, advMode, advData
+            {{1, 20, 4, 4, 0, 0},       {0x51, 0x04, 0x01, 0x00}}, // firmware defaults: regular, 2.0 mm, 0.4 mm
+            {{2, 3, 1, 1, 0, 0},        {0x0E, 0x41, 0x00, 0x00}}, // Rapid Trigger, 0.3 mm, 0.1 / 0.1 mm
+            {{1, 39, 39, 39, 0, 0},     {0x9D, 0xE7, 0x09, 0x00}}, // upper firmware limits
+            {{2, 1, 63, 63, 15, 255},   {0x06, 0xFF, 0xFF, 0xFF}}, // every bit of every field set
+            {{0, 0, 0, 0, 0, 0},        {0x00, 0x00, 0x00, 0x00}},
+        };
+        return vectors;
+    }
+
+}
+
+TEST(ProfileMemoryTest, DecodesFirmwareGoldenVectors) {
+    for (const auto& golden : goldenVectors()) {
+        const auto decoded = kbd::ProfileMemory::decodeGlobalTravel(golden.bytes);
+        ASSERT_TRUE(decoded.has_value());
+        EXPECT_EQ(*decoded, golden.config) << "bytes " << std::hex << int(golden.bytes[0]) << " " << int(golden.bytes[1])
+                                           << " " << int(golden.bytes[2]) << " " << int(golden.bytes[3]);
+    }
+}
+
+TEST(ProfileMemoryTest, EncodesFirmwareGoldenVectors) {
+    for (const auto& golden : goldenVectors()) {
+        EXPECT_EQ(kbd::ProfileMemory::encodeGlobalTravel(golden.config), golden.bytes);
+    }
+}
+
+TEST(ProfileMemoryTest, EveryFieldSurvivesARoundTrip) {
+    std::mt19937 random(12345);
+    for (int i = 0; i < 5000; ++i) {
+        kbd::GlobalTravelConfig config;
+        config.mode              = random() % 4;
+        config.actuationTenths   = random() % 64;
+        config.pressSensTenths   = random() % 64;
+        config.releaseSensTenths = random() % 64;
+        config.advancedMode      = random() % 16;
+        config.advancedData      = random() % 256;
+
+        const auto bytes = kbd::ProfileMemory::encodeGlobalTravel(config);
+        EXPECT_EQ(kbd::ProfileMemory::decodeGlobalTravel(bytes), config);
+    }
+}
+
+TEST(ProfileMemoryTest, OnlyUsesTheFirstFourBytesOfALargerDump) {
+    std::vector<std::uint8_t> dump(860, 0xAB);
+    dump[0] = 0x0E; dump[1] = 0x41; dump[2] = 0x00; dump[3] = 0x00;
+
+    const auto decoded = kbd::ProfileMemory::decodeGlobalTravel(dump);
+
+    ASSERT_TRUE(decoded.has_value());
+    EXPECT_EQ(decoded->actuationTenths, 3);
+    EXPECT_TRUE(decoded->isRapidTrigger());
+}
+
+TEST(ProfileMemoryTest, RejectsTooShortInput) {
+    const std::array<std::uint8_t, 3> tooShort{0x51, 0x04, 0x01};
+    EXPECT_FALSE(kbd::ProfileMemory::decodeGlobalTravel(tooShort).has_value());
+    EXPECT_FALSE(kbd::ProfileMemory::decodeGlobalTravel({}).has_value());
+}
+
+TEST(ProfileMemoryTest, EncodingMasksValuesToTheirFieldWidths) {
+    kbd::GlobalTravelConfig config;
+    config.mode = 0xFF;            // 2 bits
+    config.actuationTenths = 0xFF; // 6 bits
+    config.pressSensTenths = 0xFF;
+    config.releaseSensTenths = 0xFF;
+    config.advancedMode = 0xFF;    // 4 bits
+
+    const auto decoded = kbd::ProfileMemory::decodeGlobalTravel(kbd::ProfileMemory::encodeGlobalTravel(config));
+
+    ASSERT_TRUE(decoded.has_value());
+    EXPECT_EQ(decoded->mode, 3);
+    EXPECT_EQ(decoded->actuationTenths, 63);
+    EXPECT_EQ(decoded->pressSensTenths, 63);
+    EXPECT_EQ(decoded->releaseSensTenths, 63);
+    EXPECT_EQ(decoded->advancedMode, 15);
+}
+
+TEST(ProfileMemoryTest, OnlyModeTwoIsRapidTrigger) {
+    // Firmware enum: AKM_GLOBAL = 0, AKM_REGULAR = 1, AKM_RAPID = 2.
+    EXPECT_FALSE((kbd::GlobalTravelConfig{0}).isRapidTrigger());
+    EXPECT_FALSE((kbd::GlobalTravelConfig{1}).isRapidTrigger());
+    EXPECT_TRUE((kbd::GlobalTravelConfig{2}).isRapidTrigger());
+}
diff --git a/tests/test_profile_service_gateway.cpp b/tests/test_profile_service_gateway.cpp
new file mode 100644
index 0000000..9f1ea29
--- /dev/null
+++ b/tests/test_profile_service_gateway.cpp
@@ -0,0 +1,197 @@
+#include <gtest/gtest.h>
+
+#include "files/ProfileService.h"
+#include "kbd/KeyboardDevice.h"
+#include "kbd/ProfileMemory.h"
+#include "support/TempDir.h"
+#include "ui/ProfileServiceGateway.h"
+
+#include <nlohmann/json.hpp>
+
+#include <fstream>
+#include <iomanip>
+#include <sstream>
+
+// Exercises the real kbd::ProfileService + ui::ProfileServiceGateway against a dry-run KeyboardDevice,
+// which writes every packet it would have sent to a text file instead of touching the USB bus.
+
+namespace {
+
+    using kbd::GlobalTravelConfig;
+
+    std::string hexOf(const std::vector<std::uint8_t>& bytes) {
+        std::ostringstream out;
+        for (const auto b : bytes) out << std::hex << std::setw(2) << std::setfill('0') << static_cast<int>(b);
+        return out.str();
+    }
+
+    // A profile file the way the daemon expects it: a name, the slot it belongs to and the 860-byte memory dump.
+    void writeProfile(const std::filesystem::path& path, const std::string& name, const int slot,
+                      const GlobalTravelConfig& travel, const bool asHexString) {
+        std::vector<std::uint8_t> memory(860, 0);
+        const auto head = kbd::ProfileMemory::encodeGlobalTravel(travel);
+        std::copy(head.begin(), head.end(), memory.begin());
+
+        nlohmann::json json;
+        json["name"] = name;
+        json["current"] = slot;
+        if (asHexString) {
+            json["raw_hex"] = hexOf(memory);
+        } else {
+            json["memory"] = memory;
+        }
+        std::ofstream(path) << json.dump(2);
+    }
+
+    class GatewayTest : public ::testing::Test {
+    protected:
+        void SetUp() override {
+            writeProfile(dir / "default.json", "Default", 0, {GlobalTravelConfig::MODE_REGULAR, 20, 4, 4, 0, 0}, false);
+            writeProfile(dir / "tekken.json", "Tekken 8", 1, {GlobalTravelConfig::MODE_RAPID, 3, 1, 1, 0, 0}, true);
+            keyboard.setDryRun(true, (dir / "dump.txt").string());
+            service.loadAllFromDirectory(dir.path());
+        }
+
+        // Everything the dry-run device was asked to send, one packet per line.
+        std::string dump() const {
+            std::ifstream file(dir.path() / "dump.txt");
+            return std::string(std::istreambuf_iterator<char>(file), std::istreambuf_iterator<char>());
+        }
+
+        static int countOccurrences(const std::string& text, const std::string& part) {
+            int count = 0;
+            for (auto pos = text.find(part); pos != std::string::npos; pos = text.find(part, pos + part.size())) ++count;
+            return count;
+        }
+
+        test::TempDir          dir;
+        kbd::KeyboardDevice    keyboard;
+        kbd::ProfileService    service{keyboard};
+        ui::ProfileServiceGateway gateway{service, keyboard};
+    };
+
+} // namespace
+
+TEST_F(GatewayTest, DescribesSlotsFromTheProfileFiles) {
+    const auto slots = gateway.describeSlots();
+
+    EXPECT_TRUE(slots[0].hasProfile);
+    EXPECT_EQ(slots[0].name, "Default");
+    EXPECT_EQ(slots[0].fileName, "default.json");
+    ASSERT_TRUE(slots[0].storedSettings.has_value());
+    EXPECT_EQ(*slots[0].storedSettings, (ui::ActuationSettings{false, 20, 4, 4}));
+
+    EXPECT_TRUE(slots[1].hasProfile);
+    EXPECT_EQ(slots[1].name, "Tekken 8");
+    ASSERT_TRUE(slots[1].storedSettings.has_value()) << "raw_hex dumps must decode as well";
+    EXPECT_EQ(*slots[1].storedSettings, (ui::ActuationSettings{true, 3, 1, 1}));
+
+    EXPECT_FALSE(slots[2].hasProfile);
+    EXPECT_EQ(slots[2].name, "Slot 3");
+    EXPECT_FALSE(slots[2].storedSettings.has_value());
+}
+
+TEST_F(GatewayTest, ProfileWithoutAMemoryDumpStillShowsUpWithoutSettings) {
+    std::ofstream(dir / "bare.json") << R"({"name": "Bare", "current": 2})";
+    gateway.handleFileCreated(dir / "bare.json");
+
+    const auto slots = gateway.describeSlots();
+
+    EXPECT_TRUE(slots[2].hasProfile);
+    EXPECT_EQ(slots[2].name, "Bare");
+    EXPECT_FALSE(slots[2].storedSettings.has_value());
+}
+
+TEST_F(GatewayTest, FileEventsReachTheProfileService) {
+    writeProfile(dir / "gamepad.json", "Gamepad", 2, {GlobalTravelConfig::MODE_REGULAR, 14, 4, 4, 0, 0}, false);
+
+    gateway.handleFileCreated(dir / "gamepad.json");
+    EXPECT_TRUE(gateway.describeSlots()[2].hasProfile);
+
+    gateway.handleFileDeleted(dir / "gamepad.json");
+    EXPECT_FALSE(gateway.describeSlots()[2].hasProfile);
+}
+
+TEST_F(GatewayTest, DryRunDeviceReportsAsConnected) {
+    const auto device = gateway.describeDevice();
+
+    EXPECT_TRUE(device.connected);
+    EXPECT_EQ(device.transport, kbd::TransportMode::Wired);
+}
+
+TEST_F(GatewayTest, ApplyActuationSendsTheFastTravelPacket) {
+    const auto result = gateway.applyActuation(1, ui::ActuationSettings{true, 3, 1, 1});
+
+    EXPECT_TRUE(result.ok) << result.message;
+    // 0xA9 0x14 <slot> <mode> <act> <press> <release> <entire keyboard>
+    EXPECT_NE(dump().find("0xa9 0x14 0x01 0x01 0x03 0x01 0x01 0x01"), std::string::npos) << dump();
+}
+
+TEST_F(GatewayTest, ApplyActuationClampsOutOfRangeValues) {
+    const auto result = gateway.applyActuation(2, ui::ActuationSettings{false, 0, 200, 0});
+
+    EXPECT_TRUE(result.ok) << result.message;
+    // act 0 -> 1, press 200 -> 39 (0x27), release 0 -> 1
+    EXPECT_NE(dump().find("0xa9 0x14 0x02 0x00 0x01 0x27 0x01 0x01"), std::string::npos) << dump();
+}
+
+TEST_F(GatewayTest, EditingTheActiveSlotHopsToANeighbourAndBackSoTheFirmwareReloadsIt) {
+    // The dry-run keyboard always reports slot 0 as active, so applying to slot 0 edits the active slot.
+    const auto result = gateway.applyActuation(0, ui::ActuationSettings{false, 10, 4, 4});
+
+    EXPECT_TRUE(result.ok) << result.message;
+    const std::string sent = dump();
+    const auto apply = sent.find("0xa9 0x14 0x00");
+    const auto hop   = sent.find("0xa9 0x11 0x01");
+    const auto back  = sent.find("0xa9 0x11 0x00");
+    ASSERT_NE(apply, std::string::npos);
+    ASSERT_NE(hop, std::string::npos);
+    ASSERT_NE(back, std::string::npos);
+    EXPECT_LT(apply, hop);
+    EXPECT_LT(hop, back);
+}
+
+TEST_F(GatewayTest, EditingAnInactiveSlotDoesNotDisturbTheActiveOne) {
+    const auto result = gateway.applyActuation(2, ui::ActuationSettings{false, 10, 4, 4});
+
+    EXPECT_TRUE(result.ok) << result.message;
+    EXPECT_EQ(countOccurrences(dump(), "0xa9 0x11"), 0) << "no slot selection expected";
+}
+
+TEST_F(GatewayTest, SaveSlotSendsTheFlashCommitPacket) {
+    const auto result = gateway.saveSlot(2);
+
+    EXPECT_TRUE(result.ok) << result.message;
+    EXPECT_NE(dump().find("0xa9 0x1f 0x02"), std::string::npos);
+}
+
+TEST_F(GatewayTest, FlashStreamsTheWholeProfileAndCommitsIt) {
+    const auto result = gateway.flashSlotProfile(0);
+
+    EXPECT_TRUE(result.ok) << result.message;
+    EXPECT_EQ(countOccurrences(dump(), "0xa9 0x12 0x00"), 34) << "860 bytes = 33 chunks of 26 bytes + 1 of 2";
+    EXPECT_EQ(countOccurrences(dump(), "0xa9 0x1f 0x00"), 1) << "followed by the flash commit";
+}
+
+TEST_F(GatewayTest, FlashingAnEmptySlotIsRefused) {
+    const auto result = gateway.flashSlotProfile(2);
+
+    EXPECT_FALSE(result.ok);
+    EXPECT_NE(result.message.find("No profile file is assigned to Slot 3"), std::string::npos);
+    EXPECT_TRUE(dump().empty());
+}
+
+TEST_F(GatewayTest, ReadBackIsUnavailableWithoutRealHardware) {
+    EXPECT_FALSE(gateway.readActuation(0, std::nullopt).has_value());
+}
+
+TEST_F(GatewayTest, CyclingWithoutProfilesFailsCleanly) {
+    for (const auto& file : {"default.json", "tekken.json"}) {
+        gateway.handleFileDeleted(dir / file);
+    }
+
+    const auto result = gateway.cycleProfile(true);
+
+    EXPECT_FALSE(result.ok);
+    EXPECT_NE(result.message.find("No profile files"), std::string::npos);
+}
diff --git a/tests/test_sni_tray.cpp b/tests/test_sni_tray.cpp
new file mode 100644
index 0000000..afc5ffe
--- /dev/null
+++ b/tests/test_sni_tray.cpp
@@ -0,0 +1,583 @@
+#include <gtest/gtest.h>
+
+#if defined(KBD_HAVE_SNI_TRAY)
+
+#include "support/Fakes.h"
+#include "ui/SniTrayIcon.h"
+#include "ui/ThemeManager.h"
+#include "ui/TrayIconRenderer.h"
+#include "ui/TrayMenuBuilder.h"
+
+#include <gio/gio.h>
+
+#include <chrono>
+#include <condition_variable>
+#include <future>
+#include <map>
+#include <thread>
+
+// Integration tests for the Linux tray. A private dbus-daemon is started (GTestDBus) and a MockTrayHost
+// plays the desktop: it owns org.kde.StatusNotifierWatcher and records the items that register. The
+// tests then talk to the tray exactly like Plasma / waybar / the GNOME AppIndicator extension would.
+
+using namespace std::chrono_literals;
+
+namespace {
+
+    constexpr const char* WATCHER_XML = R"xml(
+<node>
+  <interface name="org.kde.StatusNotifierWatcher">
+    <method name="RegisterStatusNotifierItem"><arg type="s" name="service" direction="in"/></method>
+    <method name="RegisterStatusNotifierHost"><arg type="s" name="service" direction="in"/></method>
+    <property name="RegisteredStatusNotifierItems" type="as" access="read"/>
+    <property name="IsStatusNotifierHostRegistered" type="b" access="read"/>
+    <property name="ProtocolVersion" type="i" access="read"/>
+  </interface>
+</node>)xml";
+
+    template <typename Predicate>
+    bool waitUntil(Predicate&& predicate, const std::chrono::milliseconds timeout = 5000ms) {
+        const auto deadline = std::chrono::steady_clock::now() + timeout;
+        while (std::chrono::steady_clock::now() < deadline) {
+            if (predicate()) return true;
+            std::this_thread::sleep_for(5ms);
+        }
+        return predicate();
+    }
+
+    GDBusConnection* connectToBus(const std::string& address) {
+        GError* error = nullptr;
+        GDBusConnection* connection = g_dbus_connection_new_for_address_sync(
+            address.c_str(),
+            static_cast<GDBusConnectionFlags>(G_DBUS_CONNECTION_FLAGS_AUTHENTICATION_CLIENT | G_DBUS_CONNECTION_FLAGS_MESSAGE_BUS_CONNECTION),
+            nullptr, nullptr, &error);
+        if (error != nullptr) {
+            ADD_FAILURE() << "cannot connect to the private bus: " << error->message;
+            g_error_free(error);
+        }
+        return connection;
+    }
+
+    // The desktop side of the StatusNotifier protocol, on its own thread and main context.
+    class MockTrayHost {
+    public:
+        explicit MockTrayHost(std::string address) : m_address(std::move(address)) {}
+        ~MockTrayHost() { stop(); }
+
+        MockTrayHost(const MockTrayHost&) = delete;
+        MockTrayHost& operator=(const MockTrayHost&) = delete;
+
+        bool start() {
+            if (m_thread.joinable()) return false;
+            m_ready = std::promise<bool>();
+            std::future<bool> result = m_ready.get_future();
+            m_thread = std::jthread([this](std::stop_token) { run(); });
+            return result.wait_for(5s) == std::future_status::ready && result.get();
+        }
+
+        // The "desktop panel" going away: releases org.kde.StatusNotifierWatcher.
+        void stop() {
+            if (!m_thread.joinable()) return;
+            g_main_loop_quit(m_loop);
+            m_thread.join();
+        }
+
+        [[nodiscard]] std::vector<std::string> registered() const {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            return m_registered;
+        }
+
+    private:
+        static void onCall(GDBusConnection*, const gchar*, const gchar*, const gchar*, const gchar* method,
+                           GVariant* parameters, GDBusMethodInvocation* invocation, gpointer data) {
+            auto* self = static_cast<MockTrayHost*>(data);
+            if (std::string(method) == "RegisterStatusNotifierItem") {
+                gchar* service = nullptr;
+                g_variant_get(parameters, "(s)", &service);
+                {
+                    std::lock_guard<std::mutex> lock(self->m_mutex);
+                    self->m_registered.emplace_back(service);
+                }
+                g_free(service);
+            }
+            g_dbus_method_invocation_return_value(invocation, nullptr);
+        }
+
+        static void onNameAcquired(GDBusConnection*, const gchar*, gpointer data) {
+            static_cast<MockTrayHost*>(data)->m_ready.set_value(true);
+        }
+
+        static void onNameLost(GDBusConnection*, const gchar*, gpointer data) {
+            auto* self = static_cast<MockTrayHost*>(data);
+            try { self->m_ready.set_value(false); } catch (const std::future_error&) {}
+        }
+
+        void run() {
+            GMainContext* context = g_main_context_new();
+            g_main_context_push_thread_default(context);
+            m_loop = g_main_loop_new(context, FALSE);
+
+            GDBusConnection* connection = connectToBus(m_address);
+            GDBusNodeInfo* info = g_dbus_node_info_new_for_xml(WATCHER_XML, nullptr);
+            static const GDBusInterfaceVTable vtable = {&MockTrayHost::onCall, nullptr, nullptr, {nullptr}};
+            const guint registration = g_dbus_connection_register_object(connection, "/StatusNotifierWatcher",
+                                                                         info->interfaces[0], &vtable, this, nullptr, nullptr);
+            const guint owner = g_bus_own_name_on_connection(connection, "org.kde.StatusNotifierWatcher",
+                                                             G_BUS_NAME_OWNER_FLAGS_NONE, &MockTrayHost::onNameAcquired,
+                                                             &MockTrayHost::onNameLost, this, nullptr);
+            g_main_loop_run(m_loop);
+
+            g_bus_unown_name(owner);
+            g_dbus_connection_unregister_object(connection, registration);
+            g_dbus_node_info_unref(info);
+            g_dbus_connection_close_sync(connection, nullptr, nullptr);
+            g_object_unref(connection);
+            g_main_loop_unref(m_loop);
+            g_main_context_pop_thread_default(context);
+            g_main_context_unref(context);
+        }
+
+        std::string               m_address;
+        std::jthread              m_thread;
+        std::promise<bool>        m_ready;
+        GMainLoop*                m_loop{nullptr};
+        mutable std::mutex        m_mutex;
+        std::vector<std::string>  m_registered;
+    };
+
+    // Records what the tray tells its observers.
+    class RecordingObserver : public ui::ITrayObserver {
+    public:
+        void onTrayActivated() override { ++activated; }
+        void onTraySecondaryActivated() override { ++secondary; }
+        void onTrayMenuItemSelected(const int id) override {
+            std::lock_guard<std::mutex> lock(mutex);
+            chosen.push_back(id);
+        }
+
+        [[nodiscard]] std::vector<int> chosenItems() const {
+            std::lock_guard<std::mutex> lock(mutex);
+            return chosen;
+        }
+
+        std::atomic<int>   activated{0};
+        std::atomic<int>   secondary{0};
+        mutable std::mutex mutex;
+        std::vector<int>   chosen;
+    };
+
+    class SniTrayTest : public ::testing::Test {
+    protected:
+        static void SetUpTestSuite() {
+            gchar* daemon = g_find_program_in_path("dbus-daemon"); // allocated: must be freed
+            if (daemon == nullptr) return;
+            g_free(daemon);
+            s_bus = g_test_dbus_new(G_TEST_DBUS_NONE);
+            g_test_dbus_up(s_bus);
+        }
+
+        static void TearDownTestSuite() {
+            if (s_bus == nullptr) return;
+            g_test_dbus_down(s_bus);
+            g_object_unref(s_bus);
+            s_bus = nullptr;
+        }
+
+        void SetUp() override {
+            if (s_bus == nullptr) GTEST_SKIP() << "dbus-daemon is not installed";
+            m_address = g_test_dbus_get_bus_address(s_bus);
+            m_client  = connectToBus(m_address);
+            ASSERT_NE(m_client, nullptr);
+
+            tray.addObserver(&observer);
+            tray.setMenu(menu());
+            tray.setTooltip("Keychron K2 HE", "Slot 2: Tekken_8 (Wired USB-C)");
+            tray.setIcons(ui::renderTrayIcons(ui::Theme::blackPurple(), 1, true));
+        }
+
+        void TearDown() override {
+            tray.removeObserver(&observer);
+            tray.stop();
+            if (m_client != nullptr) {
+                g_dbus_connection_close_sync(m_client, nullptr, nullptr);
+                g_object_unref(m_client);
+            }
+        }
+
+        static ui::TrayMenu menu() {
+            ui::AppSnapshot state;
+            state.device = {true, kbd::TransportMode::Wired, "path"};
+            state.activeSlot = 1;
+            state.slots[0] = {true, "Default", "default.json", std::nullopt};
+            state.slots[1] = {true, "Tekken_8", "tekken.json", std::nullopt}; // underscore: must be escaped for dbusmenu
+            return ui::tray::buildMenu(state, true);
+        }
+
+        GVariant* call(const std::string& path, const std::string& interfaceName, const std::string& method, GVariant* parameters,
+                       const char* replyType = nullptr) {
+            GError* error = nullptr;
+            GVariant* reply = g_dbus_connection_call_sync(m_client, tray.serviceName().c_str(), path.c_str(), interfaceName.c_str(),
+                                                          method.c_str(), parameters,
+                                                          replyType != nullptr ? G_VARIANT_TYPE(replyType) : nullptr,
+                                                          G_DBUS_CALL_FLAGS_NONE, 3000, nullptr, &error);
+            if (error != nullptr) {
+                ADD_FAILURE() << method << " failed: " << error->message;
+                g_error_free(error);
+            }
+            return reply;
+        }
+
+        // Properties.GetAll as a name -> value map (values are the unwrapped GVariants; caller owns the dict).
+        GVariant* allItemProperties() {
+            GVariant* reply = call("/StatusNotifierItem", "org.freedesktop.DBus.Properties", "GetAll",
+                                   g_variant_new("(s)", "org.kde.StatusNotifierItem"), "(a{sv})");
+            if (reply == nullptr) return nullptr;
+            GVariant* dict = g_variant_get_child_value(reply, 0);
+            g_variant_unref(reply);
+            return dict;
+        }
+
+        static std::string stringProperty(GVariant* dict, const char* name) {
+            GVariant* value = g_variant_lookup_value(dict, name, G_VARIANT_TYPE_STRING);
+            if (value == nullptr) return "<missing>";
+            const std::string text = g_variant_get_string(value, nullptr);
+            g_variant_unref(value);
+            return text;
+        }
+
+        // Layout children as id -> properties dict.
+        std::map<int, GVariant*> layoutChildren(GVariant* layout) {
+            std::map<int, GVariant*> children;
+            GVariant* list = g_variant_get_child_value(layout, 2); // av
+            for (gsize i = 0; i < g_variant_n_children(list); ++i) {
+                GVariant* wrapped = g_variant_get_child_value(list, i); // v
+                GVariant* node = g_variant_get_variant(wrapped);        // (ia{sv}av)
+                gint32 id = 0;
+                g_variant_get_child(node, 0, "i", &id);
+                children[id] = g_variant_get_child_value(node, 1);
+                g_variant_unref(node);
+                g_variant_unref(wrapped);
+            }
+            g_variant_unref(list);
+            return children;
+        }
+
+        inline static GTestDBus*   s_bus = nullptr;
+        std::string                m_address;
+        GDBusConnection*           m_client = nullptr;
+        ui::SniTrayIcon            tray;
+        RecordingObserver          observer;
+    };
+
+} // namespace
