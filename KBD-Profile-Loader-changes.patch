+TEST_F(TrayPresenterTest, UnknownAndDisabledEntriesAreIgnored) {
+    presenter.start();
+    model.update([](ui::AppSnapshot& state) { state.device = {}; }); // slot switching becomes disabled
+
+    tray.choose(999999);                       // id the menu does not contain
+    choose(TrayAction::ActivateSlot1);         // disabled while disconnected
+    tray.choose(200);                          // a header
+
+    EXPECT_TRUE(commands.calls().empty());
+}
+
+TEST_F(TrayPresenterTest, TogglingAutostartFlipsTheSettingAndRefreshesTheCheckMark) {
+    presenter.start();
+    EXPECT_FALSE(tray.menu().find(ui::tray::idFor(TrayAction::ToggleAutostart))->checked);
+
+    choose(TrayAction::ToggleAutostart);
+
+    EXPECT_TRUE(system.autostart);
+    EXPECT_TRUE(tray.menu().find(ui::tray::idFor(TrayAction::ToggleAutostart))->checked);
+
+    choose(TrayAction::ToggleAutostart);
+
+    EXPECT_FALSE(system.autostart);
+    EXPECT_FALSE(tray.menu().find(ui::tray::idFor(TrayAction::ToggleAutostart))->checked);
+    EXPECT_EQ(system.calls(), (std::vector<std::string>{"autostart:on", "autostart:off"}));
+}
+
+TEST_F(TrayPresenterTest, StopUnsubscribesFromEverything) {
+    presenter.start();
+    presenter.stop();
+    const int menuUpdates = tray.menuUpdates;
+
+    model.update([](ui::AppSnapshot& state) { state.activeSlot = 2; });
+    ui::Theme custom = ui::Theme::blackPurple();
+    custom.name = "changed";
+    custom.palette.accent = ui::Color(1, 2, 3);
+    ui::ThemeManager::getInstance().setTheme(custom);
+    tray.click();
+
+    EXPECT_EQ(tray.menuUpdates, menuUpdates);
+    EXPECT_EQ(window.toggles, 0);
+    EXPECT_FALSE(tray.isRunning());
+}
+
+TEST_F(TrayPresenterTest, StartIsIdempotent) {
+    EXPECT_TRUE(presenter.start());
+    EXPECT_TRUE(presenter.start());
+
+    tray.click();
+    EXPECT_EQ(window.toggles, 1) << "double start must not register the presenter twice";
+}
diff --git a/tests/test_win32_tray.cpp b/tests/test_win32_tray.cpp
new file mode 100644
index 0000000..3bbc3c4
--- /dev/null
+++ b/tests/test_win32_tray.cpp
@@ -0,0 +1,79 @@
+#include <gtest/gtest.h>
+
+#if defined(_WIN32)
+
+#include "ui/TrayIconRenderer.h"
+#include "ui/TrayMenuBuilder.h"
+#include "ui/Win32TrayIcon.h"
+
+#include <chrono>
+#include <thread>
+
+// Lifecycle of the Windows tray backend: its message-window thread must start, accept state from other
+// threads and shut down without hanging. (Whether the taskbar shows the icon depends on the shell, so the
+// tests only require that the backend itself works; a missing taskbar is handled by TaskbarCreated.)
+
+namespace {
+
+    ui::TrayMenu sampleMenu() {
+        ui::AppSnapshot state;
+        state.device = {true, kbd::TransportMode::Wired, "path"};
+        state.activeSlot = 0;
+        state.slots[0] = {true, "Default & more", "default.json", std::nullopt}; // '&' must survive as text
+        return ui::tray::buildMenu(state, false);
+    }
+
+}
+
+TEST(Win32TrayIconTest, StartsAcceptsStateAndStopsCleanly) {
+    ui::Win32TrayIcon tray;
+    ASSERT_TRUE(tray.start());
+    EXPECT_TRUE(tray.isRunning());
+    EXPECT_EQ(tray.backendName(), "win32");
+
+    tray.setTooltip("Keychron K2 HE", "Slot 1: Default (Wired USB-C)");
+    tray.setIcons(ui::renderTrayIcons(ui::Theme::blackPurple(), 0, true));
+    tray.setMenu(sampleMenu());
+    tray.setIcons(ui::renderTrayIcons(ui::Theme::blackPurple(), 1, false)); // repaint with another state
+    std::this_thread::sleep_for(std::chrono::milliseconds(150)); // let the tray thread apply the updates
+
+    tray.stop();
+    EXPECT_FALSE(tray.isRunning());
+}
+
+TEST(Win32TrayIconTest, CanBeRestartedAfterStop) {
+    ui::Win32TrayIcon tray;
+    ASSERT_TRUE(tray.start());
+    tray.stop();
+
+    ASSERT_TRUE(tray.start());
+    EXPECT_TRUE(tray.isRunning());
+    tray.stop();
+}
+
+TEST(Win32TrayIconTest, StateSetBeforeStartIsAcceptedAndStartIsIdempotent) {
+    ui::Win32TrayIcon tray;
+    tray.setTooltip("Title", "Description");
+    tray.setMenu(sampleMenu());
+
+    ASSERT_TRUE(tray.start());
+    EXPECT_TRUE(tray.start()) << "starting twice must not create a second window";
+    tray.stop();
+    tray.stop(); // and stopping twice is fine
+}
+
+TEST(Win32TrayIconTest, DestructorStopsTheThread) {
+    {
+        ui::Win32TrayIcon tray;
+        ASSERT_TRUE(tray.start());
+    } // leaving the scope must join the message-loop thread
+    SUCCEED();
+}
+
+#else
+
+TEST(Win32TrayIconTest, WindowsOnly) {
+    GTEST_SKIP() << "Windows tray backend";
+}
+
+#endif
