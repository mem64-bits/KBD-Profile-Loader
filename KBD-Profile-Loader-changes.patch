diff --git a/headers/kbd/ProfileMemory.h b/headers/kbd/ProfileMemory.h
new file mode 100644
index 0000000..3823121
--- /dev/null
+++ b/headers/kbd/ProfileMemory.h
@@ -0,0 +1,48 @@
+#pragma once
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <span>
+
+namespace kbd {
+
+    // The "global" travel settings at the start of a Keychron analog-matrix profile
+    // (`analog_key_config_t global`, Keychron/qmk_firmware: keyboards/keychron/common/analog_matrix).
+    // The 860-byte profile dump handled by KeychronProtocol begins with these 4 packed bytes:
+    //
+    //   byte 0: bits 0-1 mode            bits 2-7 actuation point (0.1 mm)
+    //   byte 1: bits 0-5 press sens.     bits 6-7 release sens. (low 2 bits)
+    //   byte 2: bits 0-3 release sens. (high 4 bits)   bits 4-7 advanced mode
+    //   byte 3: advanced-mode data
+    struct GlobalTravelConfig {
+        static constexpr std::uint8_t MODE_GLOBAL  = 0; // key follows the profile's global mode
+        static constexpr std::uint8_t MODE_REGULAR = 1; // static actuation point
+        static constexpr std::uint8_t MODE_RAPID   = 2; // Rapid Trigger
+
+        std::uint8_t mode{MODE_REGULAR};
+        std::uint8_t actuationTenths{0};   // 0.1 mm units; 0 = "use the firmware default"
+        std::uint8_t pressSensTenths{0};   // Rapid Trigger press sensitivity, 0.1 mm units
+        std::uint8_t releaseSensTenths{0}; // Rapid Trigger release sensitivity; 0 = same as press
+        std::uint8_t advancedMode{0};
+        std::uint8_t advancedData{0};
+
+        [[nodiscard]] bool isRapidTrigger() const noexcept;
+
+        bool operator==(const GlobalTravelConfig&) const noexcept = default;
+    };
+
+    class ProfileMemory {
+    public:
+        static constexpr std::size_t GLOBAL_TRAVEL_OFFSET = 0;
+        static constexpr std::size_t GLOBAL_TRAVEL_SIZE   = 4;
+
+        // Needs at least GLOBAL_TRAVEL_SIZE bytes; extra bytes are ignored.
+        [[nodiscard]] static std::optional<GlobalTravelConfig> decodeGlobalTravel(std::span<const std::uint8_t> bytes) noexcept;
+
+        // Inverse of decodeGlobalTravel (values are masked to their field widths).
+        [[nodiscard]] static std::array<std::uint8_t, GLOBAL_TRAVEL_SIZE> encodeGlobalTravel(const GlobalTravelConfig& config) noexcept;
+    };
+
+} // namespace kbd
diff --git a/headers/ui/ActuationModel.h b/headers/ui/ActuationModel.h
new file mode 100644
index 0000000..e17715c
--- /dev/null
+++ b/headers/ui/ActuationModel.h
@@ -0,0 +1,61 @@
+#pragma once
+
+#include "kbd/ProfileMemory.h"
+
+#include <cstdint>
+#include <span>
+#include <string>
+#include <string_view>
+
+namespace ui {
+
+    namespace actuation {
+
+        // Limits enforced by the Keychron firmware (analog_matrix/profile.c): an actuation point
+        // above 3.9 mm is rejected and 0 means "use the default"; sensitivities are 0.1 - 3.9 mm.
+        inline constexpr std::uint8_t MIN_TENTHS                 = 1;
+        inline constexpr std::uint8_t MAX_TENTHS                 = 39;
+        inline constexpr std::uint8_t TOTAL_TRAVEL_TENTHS        = 40; // 4.0 mm of key travel
+        inline constexpr std::uint8_t DEFAULT_ACTUATION_TENTHS   = 20; // firmware default: 2.0 mm
+        inline constexpr std::uint8_t DEFAULT_SENSITIVITY_TENTHS = 4;  // firmware default: 0.4 mm
+
+    } // namespace actuation
+
+    // What the user can tune for a whole keyboard slot: static actuation point, or Rapid Trigger with
+    // separate press / release sensitivities. All distances are in tenths of a millimetre, which is the
+    // unit of the HID protocol, so a slider position maps 1:1 onto the byte sent to the keyboard.
+    struct ActuationSettings {
+        bool         rapidTrigger{false};
+        std::uint8_t actuationTenths{actuation::DEFAULT_ACTUATION_TENTHS};
+        std::uint8_t pressTenths{actuation::DEFAULT_SENSITIVITY_TENTHS};
+        std::uint8_t releaseTenths{actuation::DEFAULT_SENSITIVITY_TENTHS};
+
+        bool operator==(const ActuationSettings&) const noexcept = default;
+    };
+
+    namespace actuation {
+
+        [[nodiscard]] float toMillimetres(std::uint8_t tenths) noexcept;
+        [[nodiscard]] std::uint8_t clampTenths(int tenths) noexcept;
+        [[nodiscard]] std::uint8_t fromMillimetres(float millimetres) noexcept; // rounds, then clamps
+
+        // Same values with every distance clamped into the range the firmware accepts.
+        [[nodiscard]] ActuationSettings sanitized(const ActuationSettings& settings) noexcept;
+
+        // Interprets a profile's global config the way the firmware does when it loads one
+        // (profile_init: 0 / out-of-range values fall back to the defaults).
+        [[nodiscard]] ActuationSettings fromGlobalTravel(const kbd::GlobalTravelConfig& config) noexcept;
+
+        [[nodiscard]] std::string formatMillimetres(std::uint8_t tenths);   // "0.3 mm"
+        [[nodiscard]] std::string describe(const ActuationSettings& settings); // "0.3 mm, Rapid Trigger 0.1 mm / 0.1 mm"
+
+        struct Preset {
+            std::string_view  name;
+            ActuationSettings settings;
+        };
+
+        [[nodiscard]] std::span<const Preset> presets() noexcept;
+
+    } // namespace actuation
+
+} // namespace ui
diff --git a/headers/ui/AppModel.h b/headers/ui/AppModel.h
new file mode 100644
index 0000000..869001e
--- /dev/null
+++ b/headers/ui/AppModel.h
@@ -0,0 +1,58 @@
+#pragma once
+
+#include "ui/AppState.h"
+#include "ui/ObserverList.h"
+
+#include <atomic>
+#include <cstdint>
+#include <functional>
+#include <mutex>
+#include <string>
+
+namespace ui {
+
+    class IAppModelObserver {
+    public:
+        virtual ~IAppModelObserver() = default;
+
+        // Called on whichever thread changed the model, only when the state really changed.
+        // The snapshot is a hint: a later change may already be on its way.
+        virtual void onAppStateChanged(const AppSnapshot& snapshot) = 0;
+    };
+
+    // Thread-safe holder of the AppSnapshot (the "subject" of the Observer pattern). Writers call
+    // update(); readers either poll snapshot() every frame or subscribe as an IAppModelObserver.
+    class AppModel {
+    public:
+        AppModel() = default;
+        ~AppModel() = default;
+
+        AppModel(const AppModel&) = delete;
+        AppModel& operator=(const AppModel&) = delete;
+        AppModel(AppModel&&) = delete;
+        AppModel& operator=(AppModel&&) = delete;
+
+        [[nodiscard]] AppSnapshot snapshot() const;
+
+        // Incremented on every change; cheap "has anything changed?" check for render loops.
+        [[nodiscard]] std::uint64_t revision() const noexcept;
+
+        // Runs `mutation` on the state under the model's lock (it must not call back into the model),
+        // then notifies observers if the state differs from before.
+        void update(const std::function<void(AppSnapshot&)>& mutation);
+
+        // Shorthand that replaces the status line and gives it a fresh serial number.
+        void setStatus(StatusSeverity severity, std::string text);
+
+        void addObserver(IAppModelObserver* observer);
+        void removeObserver(IAppModelObserver* observer);
+
+    private:
+        mutable std::mutex              m_mutex;
+        AppSnapshot                     m_state;
+        std::uint64_t                   m_statusSerial{0}; // guarded by m_mutex
+        std::atomic<std::uint64_t>      m_revision{0};
+        ObserverList<IAppModelObserver> m_observers;
+    };
+
+} // namespace ui
diff --git a/headers/ui/AppState.h b/headers/ui/AppState.h
new file mode 100644
index 0000000..3a404bc
--- /dev/null
+++ b/headers/ui/AppState.h
@@ -0,0 +1,66 @@
+#pragma once
+
+#include "kbd/IDeviceObserver.h"
+#include "ui/ActuationModel.h"
+
+#include <array>
+#include <cstddef>
+#include <cstdint>
+#include <optional>
+#include <string>
+
+namespace ui {
+
+    // The Keychron K2 HE keeps three profiles ("slots") in flash.
+    inline constexpr std::size_t SLOT_COUNT = 3;
+
+    struct SlotInfo {
+        bool                             hasProfile{false};
+        std::string                      name;           // profile name, or "Slot N" while the slot is empty
+        std::string                      fileName;       // JSON file backing the slot
+        std::optional<ActuationSettings> storedSettings; // decoded from the profile file's memory dump
+
+        bool operator==(const SlotInfo&) const = default;
+    };
+
+    struct DeviceInfo {
+        bool               connected{false};
+        kbd::TransportMode transport{kbd::TransportMode::Disconnected};
+        std::string        path;
+
+        bool operator==(const DeviceInfo&) const = default;
+    };
+
+    enum class StatusSeverity {
+        None,
+        Info,
+        Success,
+        Warning,
+        Error
+    };
+
+    struct StatusMessage {
+        StatusSeverity severity{StatusSeverity::None};
+        std::string    text;
+        std::uint64_t  serial{0}; // changes with every message, even when the text repeats
+
+        bool operator==(const StatusMessage&) const = default;
+    };
+
+    // Everything the views and the tray need to draw themselves. Produced by ProfileController
+    // on its worker thread, consumed by the UI / tray threads as an immutable copy.
+    struct AppSnapshot {
+        DeviceInfo                                                device;
+        int                                                       activeSlot{-1}; // -1 = unknown
+        std::array<SlotInfo, SLOT_COUNT>                          slots;
+        std::array<std::optional<ActuationSettings>, SLOT_COUNT>  actuation;     // last value read back / applied
+        bool                                                      busy{false};    // a hardware command is running
+        StatusMessage                                             status;
+
+        bool operator==(const AppSnapshot&) const = default;
+    };
+
+    [[nodiscard]] const char* transportName(kbd::TransportMode mode) noexcept; // "Wired USB-C", "2.4G dongle", ...
+    [[nodiscard]] std::string slotLabel(std::size_t slot);                     // 0 -> "Slot 1"
+
+} // namespace ui
diff --git a/headers/ui/Color.h b/headers/ui/Color.h
new file mode 100644
index 0000000..07dfb40
--- /dev/null
+++ b/headers/ui/Color.h
@@ -0,0 +1,63 @@
+#pragma once
+
+#include <cstdint>
+#include <optional>
+#include <string>
+#include <string_view>
+
+namespace ui {
+
+    // 8-bit RGBA colour, independent of any UI toolkit (ImGui, Win32 and the D-Bus tray each
+    // convert it to their own representation). Plain value type: rule of zero.
+    struct Color {
+        std::uint8_t r{0};
+        std::uint8_t g{0};
+        std::uint8_t b{0};
+        std::uint8_t a{255};
+
+        constexpr Color() noexcept = default;
+        constexpr Color(std::uint8_t red, std::uint8_t green, std::uint8_t blue, std::uint8_t alpha = 255) noexcept
+            : r(red), g(green), b(blue), a(alpha) {}
+
+        // 0xRRGGBB -> Color
+        [[nodiscard]] static constexpr Color fromRgb(std::uint32_t rgb, std::uint8_t alpha = 255) noexcept {
+            return Color(static_cast<std::uint8_t>((rgb >> 16) & 0xFF),
+                         static_cast<std::uint8_t>((rgb >> 8) & 0xFF),
+                         static_cast<std::uint8_t>(rgb & 0xFF),
+                         alpha);
+        }
+
+        // Accepts "#RGB", "#RGBA", "#RRGGBB" and "#RRGGBBAA" (leading '#' optional, any case).
+        [[nodiscard]] static std::optional<Color> fromHex(std::string_view text);
+
+        // "#RRGGBB", or "#RRGGBBAA" when includeAlpha is set.
+        [[nodiscard]] std::string toHex(bool includeAlpha = false) const;
+
+        [[nodiscard]] constexpr Color withAlpha(std::uint8_t alpha) const noexcept {
+            return Color(r, g, b, alpha);
+        }
+
+        // 0xAARRGGBB, the layout used by StatusNotifierItem pixmaps.
+        [[nodiscard]] constexpr std::uint32_t toArgb() const noexcept {
+            return (static_cast<std::uint32_t>(a) << 24) | (static_cast<std::uint32_t>(r) << 16) |
+                   (static_cast<std::uint32_t>(g) << 8) | static_cast<std::uint32_t>(b);
+        }
+
+        // Linear blend towards `other` (t is clamped to 0..1, alpha is blended too).
+        [[nodiscard]] Color mix(const Color& other, float t) const noexcept;
+        [[nodiscard]] Color lighten(float amount) const noexcept; // towards white, alpha preserved
+        [[nodiscard]] Color darken(float amount) const noexcept;  // towards black, alpha preserved
+
+        // WCAG relative luminance (0 = black, 1 = white); alpha is ignored.
+        [[nodiscard]] float luminance() const noexcept;
+
+        // HSV hue in degrees, 0..360 (0 for greys).
+        [[nodiscard]] float hue() const noexcept;
+
+        // WCAG contrast ratio between two colours, 1..21.
+        [[nodiscard]] static float contrastRatio(const Color& first, const Color& second) noexcept;
+
+        constexpr bool operator==(const Color&) const noexcept = default;
+    };
+
+} // namespace ui
diff --git a/headers/ui/DemoProfileGateway.h b/headers/ui/DemoProfileGateway.h
