diff --git a/src/ui/PngWriter.cpp b/src/ui/PngWriter.cpp
new file mode 100644
index 0000000..a4c81b8
--- /dev/null
+++ b/src/ui/PngWriter.cpp
@@ -0,0 +1,112 @@
+#include "ui/PngWriter.h"
+
+#include <algorithm>
+#include <array>
+#include <fstream>
+
+namespace ui {
+
+namespace {
+
+    constexpr std::size_t MAX_STORED_BLOCK = 65535;
+
+    std::array<std::uint32_t, 256> makeCrcTable() {
+        std::array<std::uint32_t, 256> table{};
+        for (std::uint32_t n = 0; n < 256; ++n) {
+            std::uint32_t c = n;
+            for (int k = 0; k < 8; ++k) c = (c & 1u) ? 0xEDB88320u ^ (c >> 1) : c >> 1;
+            table[n] = c;
+        }
+        return table;
+    }
+
+    std::uint32_t crc32(const std::vector<std::uint8_t>& bytes, const std::size_t from) {
+        static const auto table = makeCrcTable();
+        std::uint32_t crc = 0xFFFFFFFFu;
+        for (std::size_t i = from; i < bytes.size(); ++i) crc = table[(crc ^ bytes[i]) & 0xFFu] ^ (crc >> 8);
+        return crc ^ 0xFFFFFFFFu;
+    }
+
+    void putU32(std::vector<std::uint8_t>& out, const std::uint32_t value) {
+        out.push_back(static_cast<std::uint8_t>(value >> 24));
+        out.push_back(static_cast<std::uint8_t>(value >> 16));
+        out.push_back(static_cast<std::uint8_t>(value >> 8));
+        out.push_back(static_cast<std::uint8_t>(value));
+    }
+
+    // chunk = length, type, data, CRC(type + data)
+    void putChunk(std::vector<std::uint8_t>& out, const char (&type)[5], const std::vector<std::uint8_t>& data) {
+        putU32(out, static_cast<std::uint32_t>(data.size()));
+        const std::size_t crcStart = out.size();
+        out.insert(out.end(), type, type + 4);
+        out.insert(out.end(), data.begin(), data.end());
+        putU32(out, crc32(out, crcStart));
+    }
+
+    std::uint32_t adler32(const std::vector<std::uint8_t>& bytes) {
+        std::uint32_t a = 1, b = 0;
+        for (const std::uint8_t byte : bytes) {
+            a = (a + byte) % 65521u;
+            b = (b + a) % 65521u;
+        }
+        return (b << 16) | a;
+    }
+
+} // namespace
+
+std::vector<std::uint8_t> encodePng(const int width, const int height, const std::span<const std::uint8_t> rgb) {
+    if (width <= 0 || height <= 0 ||
+        rgb.size() != static_cast<std::size_t>(width) * static_cast<std::size_t>(height) * 3) {
+        return {};
+    }
+
+    // Raw scanlines, each prefixed with filter type 0 ("none").
+    const std::size_t rowBytes = static_cast<std::size_t>(width) * 3;
+    std::vector<std::uint8_t> raw;
+    raw.reserve((rowBytes + 1) * static_cast<std::size_t>(height));
+    for (int y = 0; y < height; ++y) {
+        raw.push_back(0);
+        const auto* row = rgb.data() + static_cast<std::size_t>(y) * rowBytes;
+        raw.insert(raw.end(), row, row + rowBytes);
+    }
+
+    // zlib stream made of "stored" (uncompressed) deflate blocks.
+    std::vector<std::uint8_t> zlib{0x78, 0x01};
+    for (std::size_t offset = 0; offset < raw.size() || offset == 0;) {
+        const std::size_t length = std::min(MAX_STORED_BLOCK, raw.size() - offset);
+        const bool last = offset + length >= raw.size();
+        zlib.push_back(last ? 1 : 0);
+        zlib.push_back(static_cast<std::uint8_t>(length & 0xFF));
+        zlib.push_back(static_cast<std::uint8_t>(length >> 8));
+        zlib.push_back(static_cast<std::uint8_t>(~length & 0xFF));
+        zlib.push_back(static_cast<std::uint8_t>((~length >> 8) & 0xFF));
+        zlib.insert(zlib.end(), raw.begin() + static_cast<std::ptrdiff_t>(offset),
+                    raw.begin() + static_cast<std::ptrdiff_t>(offset + length));
+        offset += length;
+        if (last) break;
+    }
+    putU32(zlib, adler32(raw));
+
+    std::vector<std::uint8_t> header;
+    putU32(header, static_cast<std::uint32_t>(width));
+    putU32(header, static_cast<std::uint32_t>(height));
+    header.insert(header.end(), {8, 2, 0, 0, 0}); // 8-bit, truecolour RGB, default compression / filter, no interlace
+
+    std::vector<std::uint8_t> png{0x89, 'P', 'N', 'G', '\r', '\n', 0x1A, '\n'};
+    putChunk(png, "IHDR", header);
+    putChunk(png, "IDAT", zlib);
+    putChunk(png, "IEND", {});
+    return png;
+}
+
+bool writePng(const std::filesystem::path& path, const int width, const int height, const std::span<const std::uint8_t> rgb) {
+    const auto bytes = encodePng(width, height, rgb);
+    if (bytes.empty()) return false;
+
+    std::ofstream file(path, std::ios::binary | std::ios::trunc);
+    if (!file.is_open()) return false;
+    file.write(reinterpret_cast<const char*>(bytes.data()), static_cast<std::streamsize>(bytes.size()));
+    return file.good();
+}
+
+} // namespace ui
diff --git a/src/ui/ProfileController.cpp b/src/ui/ProfileController.cpp
new file mode 100644
index 0000000..3600b45
--- /dev/null
+++ b/src/ui/ProfileController.cpp
@@ -0,0 +1,351 @@
+#include "ui/ProfileController.h"
+#include "files/Logger.h"
+
+#include <exception>
+#include <optional>
+#include <utility>
+
+namespace ui {
+
+namespace {
+
+    CommandResult guarded(const std::function<CommandResult()>& command) {
+        try {
+            return command();
+        } catch (const std::exception& e) {
+            return {false, std::string("Unexpected error: ") + e.what()};
+        } catch (...) {
+            return {false, "Unexpected error."};
+        }
+    }
+
+    std::optional<ActuationSettings> guardedRead(const std::function<std::optional<ActuationSettings>()>& read) {
+        try {
+            return read();
+        } catch (const std::exception& e) {
+            LOG_WARN("UI", std::string("Reading the keyboard failed: ") + e.what());
+        } catch (...) {
+            LOG_WARN("UI", "Reading the keyboard failed.");
+        }
+        return std::nullopt;
+    }
+
+    void guardedVoid(const std::function<void()>& action) {
+        try {
+            action();
+        } catch (const std::exception& e) {
+            LOG_WARN("UI", std::string("Event handling failed: ") + e.what());
+        } catch (...) {
+            LOG_WARN("UI", "Event handling failed.");
+        }
+    }
+
+    std::uint8_t clampSlot(const std::uint8_t slot) {
+        return static_cast<std::uint8_t>(slot % SLOT_COUNT);
+    }
+
+} // namespace
+
+ProfileController::ProfileController(IProfileGateway& gateway, AppModel& model, const std::chrono::milliseconds pollInterval)
+    : m_gateway(gateway), m_model(model), m_pollInterval(pollInterval)
+{}
+
+ProfileController::~ProfileController() {
+    stop();
+}
+
+void ProfileController::start() {
+    if (m_thread.joinable()) return;
+
+    m_thread = std::jthread([this](const std::stop_token& stopToken) { workerLoop(stopToken); });
+    refresh();
+}
+
+void ProfileController::stop() {
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        m_stopped = true;
+        m_tasks.clear();
+    }
+
+    if (m_thread.joinable()) {
+        m_thread.request_stop();
+        m_wakeup.notify_all();
+        m_thread.join();
+    }
+}
+
+void ProfileController::setPollingEnabled(const bool enabled) {
+    const bool wasEnabled = m_polling.exchange(enabled);
+    if (enabled && !wasEnabled) refresh(); // opening a window: show fresh state right away
+}
+
+// ---------------------------------------------------------------------------
+// Worker
+// ---------------------------------------------------------------------------
+
+void ProfileController::post(Task task) {
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        if (m_stopped) return;
+        m_tasks.push_back(std::move(task));
+    }
+    m_wakeup.notify_one();
+}
+
+void ProfileController::workerLoop(const std::stop_token& stopToken) {
+    std::unique_lock<std::mutex> lock(m_mutex);
+
+    while (!stopToken.stop_requested()) {
+        if (m_tasks.empty()) {
+            const bool hasWork = m_wakeup.wait_for(lock, stopToken, m_pollInterval, [this] { return !m_tasks.empty(); });
+            if (stopToken.stop_requested()) break;
+
+            if (!hasWork) { // timed out with nothing queued
+                if (m_polling.load()) {
+                    lock.unlock();
+                    guardedVoid([this] { pollActiveSlot(); });
+                    lock.lock();
+                }
+                continue;
+            }
+        }
+
+        Task task = std::move(m_tasks.front());
+        m_tasks.pop_front();
+
+        lock.unlock();
+        guardedVoid(task);
+        lock.lock();
+    }
+}
+
+void ProfileController::pollActiveSlot() {
+    if (!m_gateway.describeDevice().connected) return; // reconnects arrive through the device watcher
+    const int active = m_gateway.queryActiveSlot();
+    if (active < 0) return;
+
+    m_model.update([active](AppSnapshot& state) { state.activeSlot = active; });
+}
+
+void ProfileController::refreshState(const bool queryHardware) {
+    const DeviceInfo device = m_gateway.describeDevice();
+    const auto slots        = m_gateway.describeSlots();
+    const int  activeSlot   = (queryHardware && device.connected) ? m_gateway.queryActiveSlot() : -1;
+
+    m_model.update([&](AppSnapshot& state) {
+        state.device = device;
+        state.slots  = slots;
+        if (!device.connected) {
+            state.activeSlot = -1;
+        } else if (queryHardware) {
+            state.activeSlot = activeSlot;
+        }
+    });
+}
+
+void ProfileController::beginBusy(const std::string& text) {
+    m_model.update([](AppSnapshot& state) { state.busy = true; });
+    m_model.setStatus(StatusSeverity::Info, text);
+}
+
+void ProfileController::endBusy(const StatusSeverity severity, const std::string& text) {
+    // Final message first, then drop the busy flag: the UI never shows a stale "working..." line.
+    m_model.setStatus(severity, text);
+    m_model.update([](AppSnapshot& state) { state.busy = false; });
+}
+
+// ---------------------------------------------------------------------------
+// Commands (IProfileCommands)
+// ---------------------------------------------------------------------------
+
+void ProfileController::runBusy(const std::string& busyText, const std::function<void()>& body) {
+    beginBusy(busyText);
+    try {
+        body();
+    } catch (const std::exception& e) {
+        endBusy(StatusSeverity::Error, std::string("Unexpected error: ") + e.what());
+    } catch (...) {
+        endBusy(StatusSeverity::Error, "Unexpected error.");
+    }
+}
+
+void ProfileController::runCommand(const std::string& busyText, const std::function<CommandResult()>& command) {
+    runBusy(busyText, [&] {
+        const CommandResult result = guarded(command);
+        guardedVoid([this] { refreshState(true); });
+        endBusy(result.ok ? StatusSeverity::Success : StatusSeverity::Error, result.message);
+    });
+}
+
+void ProfileController::activateSlot(const std::uint8_t slot) {
+    const std::uint8_t target = clampSlot(slot);
+    post([this, target] {
+        runCommand("Switching to " + slotLabel(target) + "...", [this, target] { return m_gateway.activateSlot(target); });
+    });
+}
+
+void ProfileController::cycleProfile(const bool forward) {
+    post([this, forward] {
+        runCommand(forward ? "Switching to the next profile..." : "Switching to the previous profile...",
+                   [this, forward] { return m_gateway.cycleProfile(forward); });
+    });
+}
+
+void ProfileController::applyActuation(const std::uint8_t slot, const ActuationSettings& settings, const bool saveToFlash) {
+    const std::uint8_t target = clampSlot(slot);
+    const ActuationSettings clean = actuation::sanitized(settings);
+    post([this, target, clean, saveToFlash] {
+        runBusy("Applying actuation to " + slotLabel(target) + "...",
+                [&] { runApplyActuation(target, clean, saveToFlash); });
+    });
+}
+
+void ProfileController::readActuation(const std::uint8_t slot) {
+    const std::uint8_t target = clampSlot(slot);
+    post([this, target] {
+        runBusy("Reading " + slotLabel(target) + " from the keyboard...", [&] { runReadActuation(target); });
+    });
+}
+
+void ProfileController::flashSlot(const std::uint8_t slot) {
+    const std::uint8_t target = clampSlot(slot);
+    post([this, target] {
+        runBusy("Writing the profile to " + slotLabel(target) + "...", [&] { runFlashSlot(target); });
+    });
+}
+
+void ProfileController::refresh() {
+    post([this] { refreshState(true); });
+}
+
+void ProfileController::runApplyActuation(const std::uint8_t slot, const ActuationSettings& settings, const bool saveToFlash) {
+    const CommandResult applied = guarded([&] { return m_gateway.applyActuation(slot, settings); });
+    if (!applied.ok) {
+        guardedVoid([this] { refreshState(true); });
+        endBusy(StatusSeverity::Error, applied.message);
+        return;
+    }
+
+    StatusSeverity severity = StatusSeverity::Success;
+    std::string    message;
+
+    // Trust, but verify: ask the keyboard what it actually stored.
+    const auto effective = guardedRead([&] { return m_gateway.readActuation(slot, settings); });
+    if (effective) {
+        m_model.update([&](AppSnapshot& state) { state.actuation[slot] = *effective; });
+        if (*effective == settings) {
+            message = slotLabel(slot) + ": " + actuation::describe(settings) + " (verified on the keyboard).";
+        } else {
+            severity = StatusSeverity::Warning;
+            message  = "The keyboard accepted the command but reports " + actuation::describe(*effective) +
+                       " instead of " + actuation::describe(settings) + ".";
+            if (effective->rapidTrigger != settings.rapidTrigger) {
+                message += " The Rapid Trigger mode byte may not match the firmware (see README, Firmware notes).";
+            }
+        }
+    } else {
+        m_model.update([&](AppSnapshot& state) { state.actuation[slot] = settings; });
+        severity = StatusSeverity::Info;
+        message  = slotLabel(slot) + ": " + actuation::describe(settings) + " applied (could not read back to verify).";
+    }
+
+    if (saveToFlash) {
+        const CommandResult saved = guarded([&] { return m_gateway.saveSlot(slot); });
+        if (saved.ok) {
+            message += " Saved to the keyboard's flash.";
+        } else {
+            if (severity == StatusSeverity::Success) severity = StatusSeverity::Warning;
+            message += " Saving to flash failed: " + saved.message;
+        }
+    }
+
+    guardedVoid([this] { refreshState(true); });
+    endBusy(severity, message);
+}
+
+void ProfileController::runReadActuation(const std::uint8_t slot) {
+    const auto effective = guardedRead([&] { return m_gateway.readActuation(slot, std::nullopt); });
+    if (effective) {
+        m_model.update([&](AppSnapshot& state) { state.actuation[slot] = *effective; });
+        endBusy(StatusSeverity::Info, slotLabel(slot) + " on the keyboard: " + actuation::describe(*effective) + ".");
+    } else {
+        endBusy(StatusSeverity::Warning, "Could not read " + slotLabel(slot) + " from the keyboard.");
+    }
+}
+
+void ProfileController::runFlashSlot(const std::uint8_t slot) {
+    const CommandResult flashed = guarded([&] { return m_gateway.flashSlotProfile(slot); });
+    if (!flashed.ok) {
+        guardedVoid([this] { refreshState(true); });
+        endBusy(StatusSeverity::Error, flashed.message);
+        return;
+    }
+
+    StatusSeverity severity = StatusSeverity::Success;
+    std::string    message  = "Profile sent to " + slotLabel(slot) + ".";
+
+    // Compare what the keyboard now holds with what the profile file says it should hold.
+    const auto expected  = m_gateway.describeSlots()[slot].storedSettings;
+    const auto effective = guardedRead([&] { return m_gateway.readActuation(slot, expected); });
+    if (effective) {
+        m_model.update([&](AppSnapshot& state) { state.actuation[slot] = *effective; });
+        if (expected && *effective != *expected) {
+            severity = StatusSeverity::Warning;
+            message  = "Profile sent to " + slotLabel(slot) + ", but the keyboard reports " + actuation::describe(*effective) +
+                       " while the profile file says " + actuation::describe(*expected) +
+                       ". The keyboard may not accept raw profile writes (see README, Firmware notes).";
+        } else if (expected) {
+            message += " Verified: the keyboard reports the profile's actuation settings.";
+        }
+    } else {
+        severity = StatusSeverity::Info;
+        message += " (Could not read back to verify.)";
+    }
+
+    guardedVoid([this] { refreshState(true); });
+    endBusy(severity, message);
+}
+
+// ---------------------------------------------------------------------------
+// Watcher events
+// ---------------------------------------------------------------------------
+
+void ProfileController::onFileCreated(const std::filesystem::path& path) {
+    post([this, path] {
+        guardedVoid([&] { m_gateway.handleFileCreated(path); });
+        guardedVoid([this] { refreshState(false); });
+        m_model.setStatus(StatusSeverity::Info, "Profile file added: " + path.filename().string());
+    });
+}
+
+void ProfileController::onFileDeleted(const std::filesystem::path& path) {
+    post([this, path] {
+        guardedVoid([&] { m_gateway.handleFileDeleted(path); });
+        guardedVoid([this] { refreshState(false); });
+        m_model.setStatus(StatusSeverity::Info, "Profile file removed: " + path.filename().string());
+    });
+}
+
+void ProfileController::onDeviceConnected(const kbd::TransportMode mode, const std::string& path) {
+    post([this, mode, path] {
+        guardedVoid([&] { m_gateway.handleDeviceConnected(mode, path); }); // re-applies the active profile
+        guardedVoid([this] { refreshState(true); });
+        m_model.update([&](AppSnapshot& state) { state.device = DeviceInfo{true, mode, path}; });
+        m_model.setStatus(StatusSeverity::Success, std::string("Keyboard connected (") + transportName(mode) + ").");
+    });
+}
+
+void ProfileController::onDeviceDisconnected() {
+    post([this] {
+        guardedVoid([this] { m_gateway.handleDeviceDisconnected(); });
+        guardedVoid([this] { refreshState(false); });
+        m_model.update([](AppSnapshot& state) {
+            state.device     = DeviceInfo{};
+            state.activeSlot = -1;
+        });
+        m_model.setStatus(StatusSeverity::Warning, "Keyboard disconnected.");
+    });
+}
+
+} // namespace ui
diff --git a/src/ui/ProfileServiceGateway.cpp b/src/ui/ProfileServiceGateway.cpp
new file mode 100644
index 0000000..efd079c
--- /dev/null
+++ b/src/ui/ProfileServiceGateway.cpp
@@ -0,0 +1,280 @@
+#include "ui/ProfileServiceGateway.h"
+#include "files/ProfileService.h"
+#include "kbd/KeyboardDevice.h"
+#include "kbd/KeychronProtocol.h"
+#include "kbd/ProfileMemory.h"
+
+#include <algorithm>
+#include <cctype>
+#include <span>
+#include <string_view>
+
+namespace ui {
+
+namespace {
+
+    using kbd::KeychronProtocol;
+
+    constexpr std::chrono::milliseconds ACK_TIMEOUT{600};
+    constexpr int                       READ_SLICE_MS = 100;
+
+    // Reply layout of a raw-profile read (AMC_GET_PROFILE_RAW):
+    // [0]=0xA9 [1]=0x12 [2]=slot [3..4]=offset [5]=size [6..]=data
+    constexpr std::size_t PROFILE_READ_DATA_OFFSET = 6;
+
+    bool containsIgnoreCase(const std::string& text, const std::string_view needle) {
+        const auto it = std::search(text.begin(), text.end(), needle.begin(), needle.end(),
+                                    [](const char a, const char b) {
+                                        return std::tolower(static_cast<unsigned char>(a)) == std::tolower(static_cast<unsigned char>(b));
+                                    });
+        return it != text.end();
+    }
+
+    // Actuation settings stored in a profile file's 860-byte memory dump, if it has a readable one.
+    std::optional<ActuationSettings> decodeStoredSettings(const KeyboardProfile& profile) {
+        try {
+            const auto memory = KeychronProtocol::extractMemoryBuffer(profile.m_configData);
+            const auto config = kbd::ProfileMemory::decodeGlobalTravel(memory);
+            if (config) return actuation::fromGlobalTravel(*config);
+        } catch (const std::exception&) {
+            return std::nullopt; // the file has no (valid) memory dump: show the profile without actuation details
+        }
+        return std::nullopt;
+    }
+
+    std::uint8_t toSlot(const std::uint8_t slot) {
+        return static_cast<std::uint8_t>(slot % SLOT_COUNT);
+    }
+
+} // namespace
+
+ProfileServiceGateway::ProfileServiceGateway(kbd::ProfileService& service, kbd::KeyboardDevice& keyboard)
+    : m_service(service), m_keyboard(keyboard)
+{}
+
+ProfileServiceGateway::~ProfileServiceGateway() = default;
+
+// ---------------------------------------------------------------------------
+// Queries
+// ---------------------------------------------------------------------------
+
+DeviceInfo ProfileServiceGateway::describeDevice() const {
+    DeviceInfo info;
+    if (m_keyboard.isDryRun()) {
+        info.connected = true;
+        info.transport = kbd::TransportMode::Wired;
+        info.path      = "(dry run)";
+        return info;
+    }
+
+    info.connected = m_keyboard.isConnected();
+    if (!info.connected) return info;
+
+    info.path = m_keyboard.getDevicePath();
+    // Same rule as kbd::DeviceWatcher: the wired keyboard (PID 0x0E21) shows up in its HID path.
+    info.transport = containsIgnoreCase(info.path, "0e21") ? kbd::TransportMode::Wired : kbd::TransportMode::WirelessDongle;
+    return info;
+}
+
+std::array<SlotInfo, SLOT_COUNT> ProfileServiceGateway::describeSlots() const {
+    std::array<SlotInfo, SLOT_COUNT> slots;
+
+    for (std::size_t i = 0; i < SLOT_COUNT; ++i) {
+        SlotInfo& info = slots[i];
+        info.name = slotLabel(i);
+
+        const auto profile = m_service.getProfileForSlot(static_cast<std::uint8_t>(i));
+        if (!profile) continue;
+
+        info.hasProfile     = true;
+        info.name           = profile->m_name;
+        info.fileName       = profile->m_filePath.filename().string();
+        info.storedSettings = decodeStoredSettings(*profile);
+    }
+    return slots;
+}
+
+// ---------------------------------------------------------------------------
+// Keyboard round-trips
+// ---------------------------------------------------------------------------
+
+int ProfileServiceGateway::queryActiveSlot() {
+    return m_service.queryActiveHardwareSlot();
+}
+
+std::optional<std::vector<std::uint8_t>> ProfileServiceGateway::awaitResponse(const std::uint8_t command,
+                                                                              const std::chrono::milliseconds timeout) {
+    const auto deadline = std::chrono::steady_clock::now() + timeout;
+    std::vector<std::uint8_t> report;
+
+    while (std::chrono::steady_clock::now() < deadline) {
+        const int bytes = m_keyboard.readReport(report, READ_SLICE_MS);
+        if (bytes < 0) return std::nullopt; // the device went away
+
+        if (bytes >= 3 && report[0] == KeychronProtocol::CMD_ANALOG_MATRIX && report[1] == command) {
+            return report;
+        }
+    }
+    return std::nullopt;
+}
+
+CommandResult ProfileServiceGateway::sendAcknowledged(const std::vector<std::uint8_t>& packet, const std::uint8_t command,
+                                                      const std::string& what) {
+    if (!describeDevice().connected) return {false, "The keyboard is not connected."};
+
+    m_keyboard.flushInputBuffer();
+    if (!m_keyboard.sendReport(packet)) return {false, "Could not send the " + what + " command to the keyboard."};
+
+    if (m_keyboard.isDryRun()) return {true, what + " sent (dry run)."};
+
+    const auto reply = awaitResponse(command, ACK_TIMEOUT);
+    if (!reply) return {false, "The keyboard did not acknowledge the " + what + " command."};
+
+    // The firmware answers with 0 on success and 1 on failure (analog_matrix.c: data[2] = success ? 0 : 1).
+    if ((*reply)[2] != 0) return {false, "The keyboard rejected the " + what + " command."};
+    return {true, what + " accepted."};
+}
+
+CommandResult ProfileServiceGateway::activateSlot(const std::uint8_t slot) {
+    const std::uint8_t target = toSlot(slot);
+
+    if (!m_service.switchHardwareSlot(target)) {
+        return {false, "The keyboard did not confirm the switch to " + slotLabel(target) + "."};
+    }
+
+    const auto profile = m_service.getProfileForSlot(target);
+    return {true, slotLabel(target) + " is active" + (profile ? " (" + profile->m_name + ")." : ".")};
+}
+
+CommandResult ProfileServiceGateway::cycleProfile(const bool forward) {
+    if (m_service.profileCount() == 0) return {false, "No profile files found in the profiles folder."};
+
+    if (forward) {
+        m_service.cycleForward();
+    } else {
+        m_service.cycleBackward();
+    }
+
+    const int active = m_service.queryActiveHardwareSlot();
+    if (active < 0) return {false, "The keyboard did not respond after switching profiles."};
+
+    const auto slot = static_cast<std::size_t>(active);
+    const auto profile = m_service.getProfileForSlot(static_cast<std::uint8_t>(active));
+    if (!profile) return {true, "Switched to " + slotLabel(slot) + "."};
+    return {true, "Switched to " + profile->m_name + " (" + slotLabel(slot) + ")."};
+}
+
+CommandResult ProfileServiceGateway::applyActuation(const std::uint8_t slot, const ActuationSettings& requested) {
+    const std::uint8_t target = toSlot(slot);
+    const ActuationSettings settings = actuation::sanitized(requested);
+
+    if (!describeDevice().connected) return {false, "The keyboard is not connected."};
+
+    m_keyboard.flushInputBuffer();
+    if (!m_service.applyFastTravel(target, settings.rapidTrigger, settings.actuationTenths,
+                                  settings.pressTenths, settings.releaseTenths)) {
+        return {false, "Could not send the actuation command to the keyboard."};
+    }
+
+    if (!m_keyboard.isDryRun()) {
+        const auto reply = awaitResponse(KeychronProtocol::AMC_SET_TRAVEL, ACK_TIMEOUT);
+        if (!reply) return {false, "The keyboard did not acknowledge the actuation command."};
+        if ((*reply)[2] != 0) return {false, "The keyboard rejected the actuation settings."};
+    }
+
+    // The firmware writes a "whole keyboard" setting into the slot's RAM profile but only rebuilds the
+    // per-key tables it actually scans with when the ACTIVE profile changes (analog_matrix/profile.c:
+    // profile_set_traval() -> no update_travel_configs() on the global path). If we just edited the active
+    // slot, hop to a neighbouring slot and back so the new values take effect immediately.
+    if (m_service.queryActiveHardwareSlot() == target) {
+        const std::uint8_t neighbour = static_cast<std::uint8_t>((target + 1) % SLOT_COUNT);
+        (void)m_service.switchHardwareSlot(neighbour);
+        if (!m_service.switchHardwareSlot(target)) {
+            return {false, "The settings were applied, but returning to " + slotLabel(target) + " failed. Select the slot again to activate them."};
+        }
+    }
+
+    return {true, "Actuation applied to " + slotLabel(target) + "."};
+}
+
+std::optional<ActuationSettings> ProfileServiceGateway::readActuation(const std::uint8_t slot,
+                                                                      const std::optional<ActuationSettings>& expected) {
+    if (m_keyboard.isDryRun() || !describeDevice().connected) return std::nullopt;
+
+    const std::uint8_t target = toSlot(slot);
+
+    // What the caller believes is stored there; falls back to the profile file, then to the defaults.
+    ActuationSettings hint = expected.value_or(ActuationSettings{});
+    if (!expected) {
+        if (const auto profile = m_service.getProfileForSlot(target)) {
+            hint = decodeStoredSettings(*profile).value_or(hint);
+        }
+    }
+    kbd::GlobalTravelConfig hintConfig;
+    hintConfig.mode              = hint.rapidTrigger ? kbd::GlobalTravelConfig::MODE_RAPID : kbd::GlobalTravelConfig::MODE_REGULAR;
+    hintConfig.actuationTenths   = hint.actuationTenths;
+    hintConfig.pressSensTenths   = hint.pressTenths;
+    hintConfig.releaseSensTenths = hint.releaseTenths;
+    const auto payload = kbd::ProfileMemory::encodeGlobalTravel(hintConfig);
+
+    // A raw-profile "chunk" request for the first GLOBAL_TRAVEL_SIZE bytes. The firmware replies with the
+    // stored bytes at [6..]; the payload we send is ignored by firmware that treats this opcode as a read.
+    const auto request = KeychronProtocol::createMemoryChunkPacket(
+        target, static_cast<std::uint16_t>(kbd::ProfileMemory::GLOBAL_TRAVEL_OFFSET), payload);
+
+    m_keyboard.flushInputBuffer();
+    if (!m_keyboard.sendReport(request)) return std::nullopt;
+
+    const auto reply = awaitResponse(KeychronProtocol::AMC_GET_PROFILE_RAW, ACK_TIMEOUT);
+    if (!reply || reply->size() < PROFILE_READ_DATA_OFFSET + kbd::ProfileMemory::GLOBAL_TRAVEL_SIZE) return std::nullopt;
+    if ((*reply)[2] != target) return std::nullopt;
+
+    const auto config = kbd::ProfileMemory::decodeGlobalTravel(
+        std::span<const std::uint8_t>(reply->data() + PROFILE_READ_DATA_OFFSET, kbd::ProfileMemory::GLOBAL_TRAVEL_SIZE));
+    if (!config) return std::nullopt;
+
+    return actuation::fromGlobalTravel(*config);
+}
+
+CommandResult ProfileServiceGateway::saveSlot(const std::uint8_t slot) {
+    const std::uint8_t target = toSlot(slot);
+    CommandResult result = sendAcknowledged(KeychronProtocol::createSaveProfilePacket(target),
+                                                  KeychronProtocol::AMC_SAVE_PROFILE, "save");
+    if (!result.ok) return result;
+    return {true, slotLabel(target) + " saved to the keyboard's flash."};
+}
+
+CommandResult ProfileServiceGateway::flashSlotProfile(const std::uint8_t slot) {
+    const std::uint8_t target = toSlot(slot);
+
+    const auto profile = m_service.getProfileForSlot(target);
+    if (!profile) return {false, "No profile file is assigned to " + slotLabel(target) + "."};
+    if (!describeDevice().connected) return {false, "The keyboard is not connected."};
+
+    if (!m_service.applyProfile(*profile, true)) {
+        return {false, "Writing '" + profile->m_name + "' to " + slotLabel(target) + " failed (see the log)."};
+    }
+    return {true, "'" + profile->m_name + "' was sent to " + slotLabel(target) + "."};
+}
+
+// ---------------------------------------------------------------------------
+// Watcher events
+// ---------------------------------------------------------------------------
+
+void ProfileServiceGateway::handleFileCreated(const std::filesystem::path& path) {
+    m_service.onFileCreated(path);
+}
+
+void ProfileServiceGateway::handleFileDeleted(const std::filesystem::path& path) {
+    m_service.onFileDeleted(path);
+}
+
+void ProfileServiceGateway::handleDeviceConnected(const kbd::TransportMode mode, const std::string& devicePath) {
+    m_service.onDeviceConnected(mode, devicePath);
+}
+
+void ProfileServiceGateway::handleDeviceDisconnected() {
+    m_service.onDeviceDisconnected();
+}
+
+} // namespace ui
