+#pragma once
+
+#include "ui/IProfileGateway.h"
+
+#include <array>
+#include <chrono>
+#include <optional>
+
+namespace ui {
+
+    // A simulated keyboard with three sample profiles, used by `--demo` to preview and theme the UI
+    // without hardware (and by tests as a more realistic fake). Commands take a short, visible amount of
+    // time like real HID round-trips do. Not thread-safe; see IProfileGateway.
+    class DemoProfileGateway : public IProfileGateway {
+    public:
+        explicit DemoProfileGateway(std::chrono::milliseconds latency = std::chrono::milliseconds(150));
+        ~DemoProfileGateway() override;
+
+        DemoProfileGateway(const DemoProfileGateway&) = delete;
+        DemoProfileGateway& operator=(const DemoProfileGateway&) = delete;
+        DemoProfileGateway(DemoProfileGateway&&) = delete;
+        DemoProfileGateway& operator=(DemoProfileGateway&&) = delete;
+
+        [[nodiscard]] DeviceInfo describeDevice() const override;
+        [[nodiscard]] std::array<SlotInfo, SLOT_COUNT> describeSlots() const override;
+
+        [[nodiscard]] int queryActiveSlot() override;
+        CommandResult activateSlot(std::uint8_t slot) override;
+        CommandResult cycleProfile(bool forward) override;
+        CommandResult applyActuation(std::uint8_t slot, const ActuationSettings& settings) override;
+        [[nodiscard]] std::optional<ActuationSettings> readActuation(std::uint8_t slot,
+                                                                     const std::optional<ActuationSettings>& expected) override;
+        CommandResult saveSlot(std::uint8_t slot) override;
+        CommandResult flashSlotProfile(std::uint8_t slot) override;
+
+        void handleFileCreated(const std::filesystem::path& path) override;
+        void handleFileDeleted(const std::filesystem::path& path) override;
+        void handleDeviceConnected(kbd::TransportMode mode, const std::string& devicePath) override;
+        void handleDeviceDisconnected() override;
+
+    private:
+        void simulateLatency() const;
+
+        std::chrono::milliseconds                 m_latency;
+        int                                       m_active{0};
+        std::array<SlotInfo, SLOT_COUNT>          m_slots;
+        std::array<ActuationSettings, SLOT_COUNT> m_hardware; // what the "keyboard" currently holds
+    };
+
+} // namespace ui
diff --git a/headers/ui/IProfileCommands.h b/headers/ui/IProfileCommands.h
new file mode 100644
index 0000000..f9f6fa7
--- /dev/null
+++ b/headers/ui/IProfileCommands.h
@@ -0,0 +1,33 @@
+#pragma once
+
+#include "ui/ActuationModel.h"
+
+#include <cstdint>
+
+namespace ui {
+
+    // What the views, the tray and the hotkey / IPC handlers may ask the keyboard to do.
+    // Every call is thread-safe and returns immediately: the work runs on a background thread and
+    // its progress and outcome show up in the AppModel (busy flag + status message).
+    class IProfileCommands {
+    public:
+        virtual ~IProfileCommands() = default;
+
+        virtual void activateSlot(std::uint8_t slot) = 0;
+        virtual void cycleProfile(bool forward) = 0;
+
+        // Whole-keyboard actuation / Rapid Trigger for `slot`. Values are clamped to what the firmware
+        // accepts. With saveToFlash the slot is committed to the keyboard's flash afterwards.
+        virtual void applyActuation(std::uint8_t slot, const ActuationSettings& settings, bool saveToFlash) = 0;
+
+        // Reads the slot's current settings back from the keyboard into the AppModel.
+        virtual void readActuation(std::uint8_t slot) = 0;
+
+        // Streams the profile file assigned to `slot` into the keyboard and commits it.
+        virtual void flashSlot(std::uint8_t slot) = 0;
+
+        // Re-reads profiles, device state and the active slot.
+        virtual void refresh() = 0;
+    };
+
+} // namespace ui
diff --git a/headers/ui/IProfileGateway.h b/headers/ui/IProfileGateway.h
new file mode 100644
index 0000000..9c61e48
--- /dev/null
+++ b/headers/ui/IProfileGateway.h
@@ -0,0 +1,54 @@
+#pragma once
+
+#include "ui/AppState.h"
+
+#include <array>
+#include <cstdint>
+#include <filesystem>
+#include <optional>
+#include <string>
+
+namespace ui {
+
+    struct CommandResult {
+        bool        ok{false};
+        std::string message;
+    };
+
+    // The port through which the ui layer reaches the profile / keyboard back end (the adapter
+    // ProfileServiceGateway implements it on top of kbd::ProfileService). Keeping it an interface lets
+    // the controller be tested with a fake and keeps ui code free of HID details.
+    //
+    // NOT thread-safe by design: ProfileController is the only caller and runs every method on its single
+    // worker thread, so profile data and HID transactions can never interleave.
+    class IProfileGateway {
+    public:
+        virtual ~IProfileGateway() = default;
+
+        // --- queries (no keyboard traffic) ---
+        [[nodiscard]] virtual DeviceInfo describeDevice() const = 0;
+        [[nodiscard]] virtual std::array<SlotInfo, SLOT_COUNT> describeSlots() const = 0;
+
+        // --- keyboard round-trips (blocking) ---
+        [[nodiscard]] virtual int queryActiveSlot() = 0; // -1 when unknown / not connected
+        virtual CommandResult activateSlot(std::uint8_t slot) = 0;
+        virtual CommandResult cycleProfile(bool forward) = 0;
+        virtual CommandResult applyActuation(std::uint8_t slot, const ActuationSettings& settings) = 0;
+
+        // Reads the slot's global actuation settings back from the keyboard. `expected` is what the caller
+        // believes is stored there; it is sent as the (normally ignored) payload of the read request so that
+        // a firmware which wrongly interpreted the request as a write would rewrite the same values.
+        [[nodiscard]] virtual std::optional<ActuationSettings> readActuation(std::uint8_t slot,
+                                                                             const std::optional<ActuationSettings>& expected) = 0;
+
+        virtual CommandResult saveSlot(std::uint8_t slot) = 0;
+        virtual CommandResult flashSlotProfile(std::uint8_t slot) = 0;
+
+        // --- events produced by the file / device watchers, forwarded to the profile service ---
+        virtual void handleFileCreated(const std::filesystem::path& path) = 0;
+        virtual void handleFileDeleted(const std::filesystem::path& path) = 0;
+        virtual void handleDeviceConnected(kbd::TransportMode mode, const std::string& devicePath) = 0;
+        virtual void handleDeviceDisconnected() = 0;
+    };
+
+} // namespace ui
