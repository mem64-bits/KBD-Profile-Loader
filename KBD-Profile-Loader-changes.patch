diff --git a/src/ui/TrayMenuBuilder.cpp b/src/ui/TrayMenuBuilder.cpp
new file mode 100644
index 0000000..cb31953
--- /dev/null
+++ b/src/ui/TrayMenuBuilder.cpp
@@ -0,0 +1,95 @@
+#include "ui/TrayMenuBuilder.h"
+
+#include <algorithm>
+#include <array>
+
+namespace ui::tray {
+
+namespace {
+
+    constexpr int SEPARATOR_ID_BASE = 100;
+    constexpr int HEADER_ID_BASE    = 200;
+
+    constexpr const char* DEVICE_NAME = "Keychron K2 HE";
+
+    std::string slotEntry(const AppSnapshot& state, const std::size_t slot) {
+        const SlotInfo& info = state.slots[slot];
+        return slotLabel(slot) + " - " + (info.hasProfile ? info.name : std::string("no profile"));
+    }
+
+} // namespace
+
+int idFor(const TrayAction action) noexcept {
+    return static_cast<int>(action);
+}
+
+TrayMenu buildMenu(const AppSnapshot& state, const bool autostartEnabled) {
+    TrayMenu menu;
+    int nextSeparatorId = SEPARATOR_ID_BASE;
+    int nextHeaderId    = HEADER_ID_BASE;
+
+    const auto header = [&](std::string label) {
+        menu.items.push_back({nextHeaderId++, TrayMenuItem::Kind::Header, std::move(label), false, false, TrayAction::None});
+    };
+    const auto separator = [&] {
+        menu.items.push_back({nextSeparatorId++, TrayMenuItem::Kind::Separator, {}, false, false, TrayAction::None});
+    };
+    const auto action = [&](const TrayAction what, std::string label, const bool enabled = true) {
+        menu.items.push_back({idFor(what), TrayMenuItem::Kind::Action, std::move(label), enabled, false, what});
+    };
+    const auto choice = [&](const TrayAction what, std::string label, const bool enabled, const bool selected) {
+        menu.items.push_back({idFor(what), TrayMenuItem::Kind::Radio, std::move(label), enabled, selected, what});
+    };
+
+    const bool connected = state.device.connected;
+    const bool canSwitch = connected && !state.busy;
+
+    header(connected ? std::string(DEVICE_NAME) + " - " + transportName(state.device.transport)
+                     : std::string(DEVICE_NAME) + " - disconnected");
+    if (connected && state.activeSlot >= 0 && state.activeSlot < static_cast<int>(SLOT_COUNT)) {
+        header("Active: " + slotEntry(state, static_cast<std::size_t>(state.activeSlot)));
+    }
+    separator();
+
+    constexpr std::array<TrayAction, SLOT_COUNT> SLOT_ACTIONS{TrayAction::ActivateSlot1, TrayAction::ActivateSlot2,
+                                                              TrayAction::ActivateSlot3};
+    for (std::size_t slot = 0; slot < SLOT_COUNT; ++slot) {
+        choice(SLOT_ACTIONS[slot], slotEntry(state, slot), canSwitch, state.activeSlot == static_cast<int>(slot));
+    }
+
+    const bool anyProfile = std::any_of(state.slots.begin(), state.slots.end(),
+                                        [](const SlotInfo& slot) { return slot.hasProfile; });
+    action(TrayAction::NextProfile, "Next profile", canSwitch && anyProfile);
+    action(TrayAction::PreviousProfile, "Previous profile", canSwitch && anyProfile);
+    separator();
+
+    action(TrayAction::OpenDashboard, "Open dashboard...");
+    action(TrayAction::OpenProfilesFolder, "Open profiles folder");
+    action(TrayAction::OpenConfigFile, "Edit config.ini");
+    action(TrayAction::OpenLogFile, "View daemon.log");
+    separator();
+
+    menu.items.push_back({idFor(TrayAction::ToggleAutostart), TrayMenuItem::Kind::Check, "Run at startup", true,
+                          autostartEnabled, TrayAction::ToggleAutostart});
+    separator();
+
+    action(TrayAction::Quit, "Exit");
+    return menu;
+}
+
+std::string tooltipTitle() {
+    return DEVICE_NAME;
+}
+
+std::string tooltipDescription(const AppSnapshot& state) {
+    if (!state.device.connected) return "Not connected";
+
+    const std::string transport = std::string(" (") + transportName(state.device.transport) + ")";
+    if (state.activeSlot < 0 || state.activeSlot >= static_cast<int>(SLOT_COUNT)) return "Connected" + transport;
+
+    const SlotInfo& slot = state.slots[static_cast<std::size_t>(state.activeSlot)];
+    const std::string label = slotLabel(static_cast<std::size_t>(state.activeSlot));
+    return (slot.hasProfile ? label + ": " + slot.name : label) + transport;
+}
+
+} // namespace ui::tray
diff --git a/src/ui/TrayPresenter.cpp b/src/ui/TrayPresenter.cpp
new file mode 100644
index 0000000..30def86
--- /dev/null
+++ b/src/ui/TrayPresenter.cpp
@@ -0,0 +1,119 @@
+#include "ui/TrayPresenter.h"
+#include "ui/ThemeManager.h"
+#include "ui/TrayIconRenderer.h"
+#include "ui/TrayMenuBuilder.h"
+
+#include <utility>
+
+namespace ui {
+
+TrayPresenter::TrayPresenter(AppModel& model, ITrayIcon& tray, IProfileCommands& commands, ISystemIntegration& system,
+                             IWindowController& window, std::function<void()> onQuit)
+    : m_model(model),
+      m_tray(tray),
+      m_commands(commands),
+      m_system(system),
+      m_window(window),
+      m_onQuit(std::move(onQuit))
+{}
+
+TrayPresenter::~TrayPresenter() {
+    stop();
+}
+
+bool TrayPresenter::start() {
+    if (m_started) return m_tray.isRunning();
+    m_started = true;
+
+    m_tray.addObserver(this);
+    m_model.addObserver(this);
+    ThemeManager::getInstance().addObserver(this);
+
+    applyState(m_model.snapshot()); // the first thing the user sees is already complete
+    return m_tray.start();
+}
+
+void TrayPresenter::stop() {
+    if (!m_started) return;
+    m_started = false;
+
+    // Unsubscribe first: once these return, no callback is running or will run again.
+    ThemeManager::getInstance().removeObserver(this);
+    m_model.removeObserver(this);
+    m_tray.removeObserver(this);
+    m_tray.stop();
+}
+
+void TrayPresenter::applyState(const AppSnapshot& state) {
+    std::lock_guard<std::mutex> applying(m_applyMutex);
+
+    TrayMenu menu = tray::buildMenu(state, m_system.isAutostartEnabled());
+    {
+        std::lock_guard<std::mutex> lock(m_menuMutex);
+        m_menu = menu;
+    }
+    m_tray.setMenu(std::move(menu));
+    m_tray.setTooltip(tray::tooltipTitle(), tray::tooltipDescription(state));
+
+    // Re-rendering the icon is the expensive part, so only do it when its inputs changed.
+    ThemeManager& themes = ThemeManager::getInstance();
+    const IconKey key{state.activeSlot, state.device.connected, themes.revision()};
+    if (!(key == m_iconKey)) {
+        m_iconKey = key;
+        m_tray.setIcons(renderTrayIcons(themes.getTheme(), state.activeSlot, state.device.connected));
+    }
+}
+
+void TrayPresenter::onAppStateChanged(const AppSnapshot& snapshot) {
+    applyState(snapshot);
+}
+
+void TrayPresenter::onThemeChanged(const Theme&) {
+    applyState(m_model.snapshot());
+}
+
+void TrayPresenter::onTrayActivated() {
+    m_window.toggleDashboard();
+}
+
+void TrayPresenter::onTraySecondaryActivated() {
+    m_commands.cycleProfile(true);
+}
+
+void TrayPresenter::onTrayMenuItemSelected(const int itemId) {
+    TrayMenuItem item;
+    {
+        std::lock_guard<std::mutex> lock(m_menuMutex);
+        const TrayMenuItem* found = m_menu.find(itemId);
+        if (found == nullptr) return; // stale id from a menu the host cached before our last update
+        item = *found;
+    }
+
+    if (!item.enabled) return;
+    dispatch(item.action);
+}
+
+void TrayPresenter::dispatch(const TrayAction action) {
+    switch (action) {
+        case TrayAction::OpenDashboard:      m_window.showDashboard(); break;
+        case TrayAction::ActivateSlot1:      m_commands.activateSlot(0); break;
+        case TrayAction::ActivateSlot2:      m_commands.activateSlot(1); break;
+        case TrayAction::ActivateSlot3:      m_commands.activateSlot(2); break;
+        case TrayAction::NextProfile:        m_commands.cycleProfile(true); break;
+        case TrayAction::PreviousProfile:    m_commands.cycleProfile(false); break;
+        case TrayAction::OpenProfilesFolder: m_system.openProfilesFolder(); break;
+        case TrayAction::OpenConfigFile:     m_system.openConfigFile(); break;
+        case TrayAction::OpenLogFile:        m_system.openLogFile(); break;
+        case TrayAction::ToggleAutostart:
+            m_system.setAutostartEnabled(!m_system.isAutostartEnabled());
+            applyState(m_model.snapshot()); // the check mark lives only in the menu, not in the model
+            break;
+        case TrayAction::Quit:
+            if (m_onQuit) m_onQuit();
+            break;
+        case TrayAction::None:
+            break;
+    }
+}
+
+} // namespace ui
