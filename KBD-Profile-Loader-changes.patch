+    std::vector<std::string> headers(const ui::TrayMenu& menu) {
+        std::vector<std::string> result;
+        for (const auto& item : menu.items) {
+            if (item.kind == TrayMenuItem::Kind::Header) result.push_back(item.label);
+        }
+        return result;
