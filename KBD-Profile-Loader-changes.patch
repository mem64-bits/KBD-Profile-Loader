diff --git a/src/ui/SystemIntegrationPosix.cpp b/src/ui/SystemIntegrationPosix.cpp
new file mode 100644
index 0000000..03580f8
--- /dev/null
+++ b/src/ui/SystemIntegrationPosix.cpp
@@ -0,0 +1,135 @@
+#if !defined(_WIN32)
+
+#include "ui/SystemIntegration.h"
+#include "files/AppPaths.h"
+#include "files/Logger.h"
+
+#include <spawn.h>
+#include <sys/types.h>
+#include <sys/wait.h>
+#include <unistd.h>
+
+#include <fstream>
+#include <string>
+#include <system_error>
+#include <thread>
+#include <vector>
+
+extern char** environ;
+
+namespace fs = std::filesystem;
+
+namespace ui {
+
+namespace {
+
+    constexpr const char* AUTOSTART_FILE_NAME = "kbd-profile-loader.desktop";
+
+    // Runs `argv` without a shell (no quoting pitfalls with unusual paths) and reaps the child in the
+    // background so it never lingers as a zombie.
+    void spawnDetached(const std::vector<std::string>& arguments) {
+        std::vector<char*> argv;
+        argv.reserve(arguments.size() + 1);
+        for (const std::string& argument : arguments) argv.push_back(const_cast<char*>(argument.c_str()));
+        argv.push_back(nullptr);
+
+        pid_t pid = 0;
+        const int result = posix_spawnp(&pid, argv[0], nullptr, nullptr, argv.data(), environ);
+        if (result != 0) {
+            LOG_WARN("System", "Could not run " + arguments[0] + ": " + std::error_code(result, std::generic_category()).message());
+            return;
+        }
+
+        std::thread([pid] {
+            int status = 0;
+            waitpid(pid, &status, 0);
+        }).detach();
+    }
+
+    // Desktop Entry spec: an Exec argument is double-quoted with \" \` \$ \\ escaped, and since the whole
+    // value is a "string" every backslash is escaped once more; a literal '%' becomes "%%".
+    std::string execArgument(const std::string& path) {
+        std::string quoted = "\"";
+        for (const char c : path) {
+            if (c == '"' || c == '`' || c == '$' || c == '\\') quoted.push_back('\\');
+            quoted.push_back(c);
+        }
+        quoted.push_back('"');
+
+        std::string value;
+        for (const char c : quoted) {
+            if (c == '\\') value.push_back('\\');
+            if (c == '%') value.push_back('%');
+            value.push_back(c);
+        }
+        return value;
+    }
+
+    fs::path autostartEntryPath() {
+        return Files::AppPaths::getAutostartDir() / AUTOSTART_FILE_NAME;
+    }
+
+} // namespace
+
+void SystemIntegration::openPath(const fs::path& path) {
+    spawnDetached({"xdg-open", path.string()});
+}
+
+fs::path SystemIntegration::resolveExecutable() const {
+    if (!m_executablePath.empty()) return m_executablePath;
+
+    std::error_code ec;
+    const fs::path self = fs::read_symlink("/proc/self/exe", ec);
+    return ec ? fs::path{} : self;
+}
+
+bool SystemIntegration::isAutostartEnabled() const {
+    std::error_code ec;
+    return fs::exists(autostartEntryPath(), ec);
+}
+
+bool SystemIntegration::setAutostartEnabled(const bool enabled) {
+    const fs::path entry = autostartEntryPath();
+    std::error_code ec;
+
+    if (!enabled) {
+        fs::remove(entry, ec);
+        if (ec) {
+            LOG_WARN("System", "Could not remove the autostart entry: " + ec.message());
+            return false;
+        }
+        LOG_INFO("System", "Autostart disabled (removed " + entry.string() + ").");
+        return true;
+    }
+
+    const fs::path executable = resolveExecutable();
+    if (executable.empty()) {
+        LOG_WARN("System", "Could not determine the path of this program; autostart not enabled.");
+        return false;
+    }
+
+    fs::create_directories(entry.parent_path(), ec);
+    std::ofstream file(entry, std::ios::trunc);
+    if (!file.is_open()) {
+        LOG_WARN("System", "Could not write " + entry.string());
+        return false;
+    }
+
+    file << "[Desktop Entry]\n"
+         << "Type=Application\n"
+         << "Name=Keychron K2 HE Profile Daemon\n"
+         << "Comment=Switch Keychron K2 HE profiles from the system tray\n"
+         << "Exec=" << execArgument(executable.string()) << "\n"
+         << "Icon=input-keyboard\n"
+         << "Terminal=false\n"
+         << "X-GNOME-Autostart-enabled=true\n";
+    file.flush();
+    if (!file.good()) return false;
+
+    LOG_INFO("System", "Autostart enabled (" + entry.string() + ").");
+    return true;
+}
+
+} // namespace ui
+
+#endif // !_WIN32
diff --git a/src/ui/SystemIntegrationWin32.cpp b/src/ui/SystemIntegrationWin32.cpp
new file mode 100644
index 0000000..9574f5a
--- /dev/null
+++ b/src/ui/SystemIntegrationWin32.cpp
@@ -0,0 +1,123 @@
+#if defined(_WIN32)
+
+#include "ui/SystemIntegration.h"
+#include "files/AppPaths.h"
+#include "files/Logger.h"
+
+#ifndef WIN32_LEAN_AND_MEAN
+    #define WIN32_LEAN_AND_MEAN
+#endif
+#ifndef NOMINMAX
+    #define NOMINMAX
+#endif
+// This file calls the wide (W) Win32 functions explicitly; UNICODE makes macros such as IDI_APPLICATION
+// resolve to their wide variants too, instead of the ANSI ones.
+#ifndef UNICODE
+    #define UNICODE
+#endif
+#ifndef _UNICODE
+    #define _UNICODE
+#endif
+#include <windows.h>
+#include <objbase.h>
+#include <shellapi.h>
+#include <shlobj.h>
+
+#include <string>
+#include <system_error>
+
+namespace fs = std::filesystem;
+
+namespace ui {
+
+namespace {
+
+    // Same shortcut name the installer (CPack/NSIS) puts into the Startup folder, so both agree.
+    constexpr const wchar_t* STARTUP_SHORTCUT_NAME = L"Keychron Daemon.lnk";
+
+    fs::path startupShortcutPath() {
+        return Files::AppPaths::getWindowsStartupDir() / STARTUP_SHORTCUT_NAME;
+    }
+
+    fs::path currentExecutable() {
+        std::wstring buffer(MAX_PATH, L'\0');
+        for (;;) {
+            const DWORD length = GetModuleFileNameW(nullptr, buffer.data(), static_cast<DWORD>(buffer.size()));
+            if (length == 0) return {};
+            if (length < buffer.size()) {
+                buffer.resize(length);
+                return fs::path(buffer);
+            }
+            buffer.resize(buffer.size() * 2); // path longer than the buffer: grow and retry
+        }
+    }
+
+    bool createShortcut(const fs::path& link, const fs::path& target) {
+        const HRESULT initialised = CoInitializeEx(nullptr, COINIT_APARTMENTTHREADED);
+        const bool mustUninitialise = SUCCEEDED(initialised); // S_FALSE also needs a matching CoUninitialize
+
+        IShellLinkW* shellLink = nullptr;
+        HRESULT result = CoCreateInstance(CLSID_ShellLink, nullptr, CLSCTX_INPROC_SERVER, IID_IShellLinkW,
+                                          reinterpret_cast<void**>(&shellLink));
+        if (SUCCEEDED(result)) {
+            shellLink->SetPath(target.c_str());
+            shellLink->SetWorkingDirectory(target.parent_path().c_str());
+            shellLink->SetDescription(L"Keychron K2 HE profile daemon");
+
+            IPersistFile* file = nullptr;
+            result = shellLink->QueryInterface(IID_IPersistFile, reinterpret_cast<void**>(&file));
+            if (SUCCEEDED(result)) {
+                result = file->Save(link.c_str(), TRUE);
+                file->Release();
+            }
+            shellLink->Release();
+        }
+
+        if (mustUninitialise) CoUninitialize();
+        return SUCCEEDED(result);
+    }
+
+} // namespace
+
+void SystemIntegration::openPath(const fs::path& path) {
+    const auto result = reinterpret_cast<INT_PTR>(ShellExecuteW(nullptr, L"open", path.c_str(), nullptr, nullptr, SW_SHOWNORMAL));
+    if (result <= 32) { // ShellExecute reports errors as values <= 32
+        LOG_WARN("System", "Could not open " + path.string());
+    }
+}
+
+fs::path SystemIntegration::resolveExecutable() const {
+    return m_executablePath.empty() ? currentExecutable() : m_executablePath;
+}
+
+bool SystemIntegration::isAutostartEnabled() const {
+    std::error_code ec;
+    return fs::exists(startupShortcutPath(), ec);
+}
+
+bool SystemIntegration::setAutostartEnabled(const bool enabled) {
+    const fs::path shortcut = startupShortcutPath();
+    std::error_code ec;
+
+    if (!enabled) {
+        fs::remove(shortcut, ec);
+        if (ec) {
+            LOG_WARN("System", "Could not remove the Startup shortcut: " + ec.message());
+            return false;
+        }
+        LOG_INFO("System", "Disabled Windows auto-start (removed the Startup shortcut).");
+        return true;
+    }
+
+    const fs::path executable = resolveExecutable();
+    if (executable.empty() || !createShortcut(shortcut, executable)) {
+        LOG_WARN("System", "Could not create the Startup shortcut.");
+        return false;
+    }
+    LOG_INFO("System", "Enabled Windows auto-start (created a shortcut in the Startup folder).");
+    return true;
+}
+
+} // namespace ui
+
+#endif // _WIN32
diff --git a/src/ui/Theme.cpp b/src/ui/Theme.cpp
new file mode 100644
index 0000000..b614a62
--- /dev/null
+++ b/src/ui/Theme.cpp
@@ -0,0 +1,188 @@
+#include "ui/Theme.h"
+
+#include <nlohmann/json.hpp>
+
+#include <algorithm>
+#include <array>
+#include <cmath>
+
+namespace ui {
+
+namespace {
+
+    struct ColorField {
+        const char*         key;
+        Color ThemePalette::* member;
+    };
+
+    struct MetricField {
+        const char*         key;
+        float ThemeMetrics::* member;
+        float               minimum;
+        float               maximum;
+    };
+
+    constexpr std::array<ColorField, 14> COLOR_FIELDS{{
+        {"background",    &ThemePalette::background},
+        {"surface",       &ThemePalette::surface},
+        {"surfaceRaised", &ThemePalette::surfaceRaised},
+        {"border",        &ThemePalette::border},
+        {"text",          &ThemePalette::text},
+        {"textMuted",     &ThemePalette::textMuted},
+        {"textOnAccent",  &ThemePalette::textOnAccent},
+        {"accent",        &ThemePalette::accent},
+        {"accentHover",   &ThemePalette::accentHover},
+        {"accentActive",  &ThemePalette::accentActive},
+        {"accentText",    &ThemePalette::accentText},
+        {"success",       &ThemePalette::success},
+        {"warning",       &ThemePalette::warning},
+        {"danger",        &ThemePalette::danger},
+    }};
+
+    constexpr std::array<MetricField, 14> METRIC_FIELDS{{
+        {"windowRounding",   &ThemeMetrics::windowRounding,   0.0f, 32.0f},
+        {"frameRounding",    &ThemeMetrics::frameRounding,    0.0f, 32.0f},
+        {"popupRounding",    &ThemeMetrics::popupRounding,    0.0f, 32.0f},
+        {"tabRounding",      &ThemeMetrics::tabRounding,      0.0f, 32.0f},
+        {"scrollbarRounding",&ThemeMetrics::scrollbarRounding,0.0f, 32.0f},
+        {"windowBorderSize", &ThemeMetrics::windowBorderSize, 0.0f, 4.0f},
+        {"frameBorderSize",  &ThemeMetrics::frameBorderSize,  0.0f, 4.0f},
+        {"windowPaddingX",   &ThemeMetrics::windowPaddingX,   0.0f, 48.0f},
+        {"windowPaddingY",   &ThemeMetrics::windowPaddingY,   0.0f, 48.0f},
+        {"framePaddingX",    &ThemeMetrics::framePaddingX,    0.0f, 32.0f},
+        {"framePaddingY",    &ThemeMetrics::framePaddingY,    0.0f, 32.0f},
+        {"itemSpacingX",     &ThemeMetrics::itemSpacingX,     0.0f, 32.0f},
+        {"itemSpacingY",     &ThemeMetrics::itemSpacingY,     0.0f, 32.0f},
+        {"fontSize",         &ThemeMetrics::fontSize,         10.0f, 32.0f},
+    }};
+
+    void report(std::vector<ThemeIssue>* issues, std::string field, std::string message) {
+        if (issues != nullptr) issues->push_back({std::move(field), std::move(message)});
+    }
+
+    bool isKnownTopLevelKey(const std::string& key) {
+        return key == "name" || key == "fontFile" || key == "colors" || key == "metrics";
+    }
+
+} // namespace
+
+Theme Theme::blackPurple() {
+    return Theme{};
+}
+
+std::optional<Theme> Theme::fromJson(const nlohmann::json& json, std::vector<ThemeIssue>* issues) {
+    if (!json.is_object()) {
+        report(issues, "", "A theme must be a JSON object.");
+        return std::nullopt;
+    }
+
+    Theme theme = Theme::blackPurple();
+
+    for (const auto& [key, value] : json.items()) {
+        (void)value;
+        if (!isKnownTopLevelKey(key)) report(issues, key, "Unknown key ignored.");
+    }
+
+    if (const auto it = json.find("name"); it != json.end()) {
+        if (it->is_string()) {
+            theme.name = it->get<std::string>();
+        } else {
+            report(issues, "name", "Expected a string.");
+        }
+    }
+
+    if (const auto it = json.find("fontFile"); it != json.end()) {
+        if (it->is_string()) {
+            theme.fontFile = it->get<std::string>();
+        } else {
+            report(issues, "fontFile", "Expected a path to a .ttf file as a string.");
+        }
+    }
+
+    bool accentGiven = false;
+    bool hoverGiven  = false;
+    bool activeGiven = false;
+
+    if (const auto it = json.find("colors"); it != json.end()) {
+        if (!it->is_object()) {
+            report(issues, "colors", "Expected an object of colour names to \"#RRGGBB\" strings.");
+        } else {
+            for (const auto& [key, value] : it->items()) {
+                const auto field = std::find_if(COLOR_FIELDS.begin(), COLOR_FIELDS.end(),
+                                                [&key](const ColorField& f) { return key == f.key; });
+                if (field == COLOR_FIELDS.end()) {
+                    report(issues, "colors." + key, "Unknown colour name ignored.");
+                    continue;
+                }
+                if (!value.is_string()) {
+                    report(issues, "colors." + key, "Expected a string such as \"#7C3AED\".");
+                    continue;
+                }
+                const auto parsed = Color::fromHex(value.get<std::string>());
+                if (!parsed) {
+                    report(issues, "colors." + key, "Invalid colour '" + value.get<std::string>() + "'.");
+                    continue;
+                }
+
+                theme.palette.*(field->member) = *parsed;
+                accentGiven = accentGiven || key == "accent";
+                hoverGiven  = hoverGiven  || key == "accentHover";
+                activeGiven = activeGiven || key == "accentActive";
+            }
+        }
+    }
+
+    // Convenience: a theme that only sets "accent" still gets coherent hover/pressed shades.
+    if (accentGiven && !hoverGiven)  theme.palette.accentHover  = theme.palette.accent.lighten(0.18f);
+    if (accentGiven && !activeGiven) theme.palette.accentActive = theme.palette.accent.darken(0.18f);
+
+    if (const auto it = json.find("metrics"); it != json.end()) {
+        if (!it->is_object()) {
+            report(issues, "metrics", "Expected an object of sizes.");
+        } else {
+            for (const auto& [key, value] : it->items()) {
+                const auto field = std::find_if(METRIC_FIELDS.begin(), METRIC_FIELDS.end(),
+                                                [&key](const MetricField& f) { return key == f.key; });
+                if (field == METRIC_FIELDS.end()) {
+                    report(issues, "metrics." + key, "Unknown metric ignored.");
+                    continue;
+                }
+                if (!value.is_number()) {
+                    report(issues, "metrics." + key, "Expected a number.");
+                    continue;
+                }
+
+                const float requested = value.get<float>();
+                const float clamped   = std::clamp(requested, field->minimum, field->maximum);
+                if (!std::isfinite(requested) || clamped != requested) {
+                    report(issues, "metrics." + key, "Value out of range; clamped.");
+                }
+                theme.metrics.*(field->member) = std::isfinite(clamped) ? clamped : field->minimum;
+            }
+        }
+    }
+
+    return theme;
+}
+
+nlohmann::json Theme::toJson() const {
+    nlohmann::json colors = nlohmann::json::object();
+    for (const auto& field : COLOR_FIELDS) {
+        const Color& color = palette.*(field.member);
+        colors[field.key] = color.toHex(color.a != 255);
+    }
+
+    nlohmann::json sizes = nlohmann::json::object();
+    for (const auto& field : METRIC_FIELDS) {
+        sizes[field.key] = metrics.*(field.member);
+    }
+
+    nlohmann::json json = nlohmann::json::object();
+    json["name"]     = name;
+    json["fontFile"] = fontFile;
+    json["colors"]   = std::move(colors);
+    json["metrics"] = std::move(sizes);
+    return json;
+}
+
+} // namespace ui
diff --git a/src/ui/ThemeManager.cpp b/src/ui/ThemeManager.cpp
new file mode 100644
index 0000000..ff62a81
--- /dev/null
+++ b/src/ui/ThemeManager.cpp
@@ -0,0 +1,131 @@
+#include "ui/ThemeManager.h"
+#include "files/Logger.h"
+
+#include <nlohmann/json.hpp>
+
+#include <fstream>
+#include <system_error>
+
+namespace fs = std::filesystem;
+
+namespace ui {
+
+ThemeManager& ThemeManager::getInstance() {
+    static ThemeManager instance;
+    return instance;
+}
+
+Theme ThemeManager::getTheme() const {
+    std::lock_guard<std::mutex> lock(m_mutex);
+    return m_theme;
+}
+
+std::uint64_t ThemeManager::revision() const noexcept {
+    return m_revision.load(std::memory_order_acquire);
+}
+
+void ThemeManager::setTheme(Theme theme) {
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        if (theme == m_theme) return;
+        m_theme = theme;
+        m_revision.fetch_add(1, std::memory_order_acq_rel);
+    }
+
+    // Notify outside m_mutex so an observer may call getTheme() from its callback.
+    m_observers.notify([&theme](IThemeObserver& observer) { observer.onThemeChanged(theme); });
+}
+
+void ThemeManager::resetToDefault() {
+    setTheme(Theme::blackPurple());
+}
+
+bool ThemeManager::loadFromFile(const fs::path& path, std::vector<ThemeIssue>* issues) {
+    std::ifstream file(path);
+    if (!file.is_open()) {
+        if (issues != nullptr) issues->push_back({"", "Could not open " + path.string()});
+        return false;
+    }
+
+    const nlohmann::json json = nlohmann::json::parse(file, nullptr, false);
+    if (json.is_discarded()) {
+        LOG_WARN("Theme", "Ignoring " + path.filename().string() + ": it is not valid JSON.");
+        if (issues != nullptr) issues->push_back({"", path.filename().string() + " is not valid JSON."});
+        return false;
+    }
+
+    std::vector<ThemeIssue> localIssues;
+    const auto theme = Theme::fromJson(json, &localIssues);
+    for (const auto& issue : localIssues) {
+        LOG_WARN("Theme", path.filename().string() + ": " + issue.field + (issue.field.empty() ? "" : ": ") + issue.message);
+    }
+    if (issues != nullptr) issues->insert(issues->end(), localIssues.begin(), localIssues.end());
+    if (!theme) return false;
+
+    std::error_code ec;
+    const auto modified = fs::last_write_time(path, ec);
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        m_sourcePath = path;
+        m_sourceTime = ec ? fs::file_time_type{} : modified;
+    }
+
+    setTheme(*theme);
+    return true;
+}
+
+bool ThemeManager::saveToFile(const fs::path& path) const {
+    const Theme theme = getTheme();
+
+    try {
+        if (path.has_parent_path()) fs::create_directories(path.parent_path());
+
+        // Write-then-rename so a hot-reloading reader never sees a half-written file.
+        fs::path temporary = path;
+        temporary += ".tmp";
+        {
+            std::ofstream file(temporary, std::ios::trunc);
+            if (!file.is_open()) return false;
+            file << theme.toJson().dump(2) << '\n';
+            if (!file.good()) return false;
+        }
+        fs::rename(temporary, path);
+        return true;
+    } catch (const std::exception& e) {
+        LOG_WARN("Theme", std::string("Could not save theme: ") + e.what());
+        return false;
+    }
+}
+
+bool ThemeManager::reloadIfChanged() {
+    fs::path path;
+    fs::file_time_type known;
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        path  = m_sourcePath;
+        known = m_sourceTime;
+    }
+    if (path.empty()) return false;
+
+    std::error_code ec;
+    const auto current = fs::last_write_time(path, ec);
+    if (ec || current == known) return false;
+
+    {
+        // Remember the timestamp first: a file that is mid-edit (invalid JSON) is retried
+        // only after it changes again, instead of re-parsing and logging every poll.
+        std::lock_guard<std::mutex> lock(m_mutex);
+        m_sourceTime = current;
+    }
+    return loadFromFile(path);
+}
+
+void ThemeManager::addObserver(IThemeObserver* observer) {
+    m_observers.add(observer);
+}
+
+void ThemeManager::removeObserver(IThemeObserver* observer) {
+    m_observers.remove(observer);
+}
+
+} // namespace ui
