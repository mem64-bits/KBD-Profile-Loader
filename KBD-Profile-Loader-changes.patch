+
+    void mutedWrapped(const ThemePalette& palette, const char* text) {
+        ImGui::PushStyleColor(ImGuiCol_Text, toImVec4(palette.textMuted));
+        ImGui::TextWrapped("%s", text);
+        ImGui::PopStyleColor();
+    }
+
